---
import "@blabbun/ui/styles/global.css";

import { Footer, Navbar } from "@blabbun/ui/components/layouts";
import { getCollection } from "astro:content";
import { ClientRouter } from "astro:transitions";

import ScrollToTop from "@/components/layouts/ScrollToTop.svelte";
import SearchDropdown from "@/components/search/SearchDropdown.svelte";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
}

const {
  title: rawTitle,
  description = "Blab Bun — a quiet corner of the internet where thoughts settle, drift, and take shape. Unfiltered reflections, no pressure to be complete.",
  ogImage,
  ogType = "website",
} = Astro.props;

const siteTitle = "Blab Bun";
const pageTitle = rawTitle ? `${rawTitle} · ${siteTitle}` : siteTitle;
const canonicalUrl = Astro.url.href;
const siteUrl =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://blabbun.com";

const { pathname } = Astro.url;
// Nav matches design exactly: "home" | "all posts"
const navLinks = [
  { label: "home", href: "/", active: pathname === "/" },
  {
    label: "all posts",
    href: "/archive",
    active: pathname === "/archive" || pathname.startsWith("/topics"),
  },
];

// Word count for footer + post count for nav
const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const totalWords = allPosts.reduce(
  (a, p) => a + (p.body?.trim().split(/\s+/).length ?? 0),
  0
);
const postCount = allPosts.length;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;500;700&family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&display=swap"
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/webp" href="/blabbun-logo.webp" />
    <link rel="apple-touch-icon" href="/blabbun-logo.webp" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Blab Bun"
      href="/rss.xml"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/ibm-plex-mono-400.woff2"
      crossorigin
    />
    <meta name="generator" content={Astro.generator} />

    <!-- Prevent theme flash: set body class before paint -->
    <script is:inline>
      (function () {
        document.documentElement.classList.add("js");
        const t = localStorage.getItem("bb-theme") || "dark";
        document.documentElement.setAttribute("data-theme-loading", t);
      })();
    </script>
    <style is:inline>
      html[data-theme-loading="dark"] {
        background: #16120e;
        color: #f0e0c8;
      }
      html[data-theme-loading="light"] {
        background: #fdf9f4;
        color: #6b4a35;
      }
    </style>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="blabbun, blab bun, personal blog, writing, thoughts, essays"
    />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {
      ogImage && (
        <>
          <meta
            property="og:image"
            content={
              ogImage.startsWith("http") ? ogImage : `${siteUrl}${ogImage}`
            }
          />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={pageTitle} />
        </>
      )
    }
    <meta
      name="twitter:card"
      content={ogImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {
      ogImage && (
        <meta
          name="twitter:image"
          content={
            ogImage.startsWith("http") ? ogImage : `${siteUrl}${ogImage}`
          }
        />
      )
    }
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: siteTitle,
        alternateName: "blabbun",
        url: siteUrl,
        description,
        potentialAction: {
          "@type": "SearchAction",
          target: `${siteUrl}/archive?q={search_term_string}`,
          "query-input": "required name=search_term_string",
        },
      })}
    />

    <style>
      @font-face {
        font-family: "IBM Plex Mono";
        font-style: normal;
        font-display: swap;
        font-weight: 400;
        src: url("/fonts/ibm-plex-mono-400.woff2") format("woff2");
      }
      @font-face {
        font-family: "IBM Plex Mono";
        font-style: normal;
        font-display: swap;
        font-weight: 500;
        src: url("/fonts/ibm-plex-mono-500.woff2") format("woff2");
      }
      @font-face {
        font-family: "IBM Plex Mono";
        font-style: normal;
        font-display: swap;
        font-weight: 600;
        src: url("/fonts/ibm-plex-mono-600.woff2") format("woff2");
      }
      @font-face {
        font-family: "IBM Plex Mono";
        font-style: italic;
        font-display: swap;
        font-weight: 400;
        src: url("/fonts/ibm-plex-mono-400-italic.woff2") format("woff2");
      }
    </style>
    <meta
      name="theme-color"
      content="#fdf9f4"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#16120e"
      media="(prefers-color-scheme: dark)"
    />
    <ClientRouter />
  </head>
  <body
    class="dark"
    style="min-height:100vh;display:flex;flex-direction:column"
  >
    <script is:inline>
      document.body.className = localStorage.getItem("bb-theme") || "dark";
    </script>
    <Navbar client:load links={navLinks} postCount={postCount} />
    <SearchDropdown client:idle />
    <ScrollToTop client:idle />
    <div style="flex:1" transition:name="main-content">
      <slot />
    </div>
    <Footer wordCount={totalWords} />
    <script>
      function initReveal() {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("visible");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15 }
        );
        document
          .querySelectorAll(".reveal:not(.visible)")
          .forEach((el) => io.observe(el));
      }

      // Run immediately for SSR'd elements already in the DOM.
      initReveal();

      // client:idle and client:visible components hydrate via requestIdleCallback,
      // adding new .reveal elements after initReveal() ran. Re-run on idle so those
      // elements get picked up.
      requestIdleCallback(initReveal, { timeout: 2000 });

      // Re-run after each View Transitions soft navigation.
      // Keep this script as a module (no is:inline) so Astro deduplicates it.
      document.addEventListener("astro:page-load", initReveal);
    </script>
  </body>
</html>
