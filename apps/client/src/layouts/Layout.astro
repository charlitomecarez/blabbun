---
import "@thelunan/ui/styles/global.css";

import { Footer, Navbar } from "@thelunan/ui/components/layouts";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>The Lunan</title>
    <meta
      name="description"
      content="A quiet corner of the internet where thoughts settle, drift, and take shape. Unfiltered reflections — no pressure to be complete."
    />
    <!-- Space Grotesk (headings) + Manrope (body) from Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&family=Space+Grotesk:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="font-manrope flex min-h-screen flex-col bg-[#f1f8f3] text-[#29302d] antialiased"
  >
    <!-- Fixed navbar — pages use pt-[67px] to compensate -->
    <Navbar client:load />
    <div class="flex-1">
      <slot />
    </div>
    <Footer />
  </body>
</html>
