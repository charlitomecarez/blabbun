---
import "@blabbun/ui/styles/global.css";

import { Footer, Navbar } from "@blabbun/ui/components/layouts";
import { getCollection } from "astro:content";

import ScrollToTop from "@/components/layouts/ScrollToTop.svelte";
import SearchDropdown from "@/components/search/SearchDropdown.svelte";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
}

const {
  title: rawTitle,
  description = "A quiet corner of the internet where thoughts settle, drift, and take shape. Unfiltered reflections — no pressure to be complete.",
  ogImage,
  ogType = "website",
} = Astro.props;

const siteTitle = "Blab Bun";
const pageTitle = rawTitle ? `${rawTitle} · ${siteTitle}` : siteTitle;
const canonicalUrl = Astro.url.href;
const siteUrl =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://blabbun.com";

const { pathname } = Astro.url;
// Nav matches design exactly: "home" | "all posts"
const navLinks = [
  { label: "home", href: "/", active: pathname === "/" },
  {
    label: "posts",
    href: "/archive",
    active: pathname === "/archive" || pathname.startsWith("/topics"),
  },
  // { label: "about", href: "/about", active: pathname === "/about" },
];

// Word count for footer
const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const totalWords = allPosts.reduce(
  (a, p) => a + (p.body?.trim().split(/\s+/).length ?? 0),
  0
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/blabbun.png" />
    <link rel="apple-touch-icon" href="/blabbun.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Blab Bun"
      href="/rss.xml"
    />
    <meta name="generator" content={Astro.generator} />

    <!-- Prevent theme flash: set body class before paint -->
    <script is:inline>
      (function () {
        const t = localStorage.getItem("bb-theme") || "light";
        document.documentElement.setAttribute("data-theme-loading", t);
      })();
    </script>
    <style is:inline>
      html[data-theme-loading="dark"] {
        background: #16120e;
        color: #e6ddd1;
      }
      html[data-theme-loading="light"] {
        background: #fdf9f4;
        color: #231e17;
      }
    </style>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {
      ogImage && (
        <>
          <meta
            property="og:image"
            content={
              ogImage.startsWith("http") ? ogImage : `${siteUrl}${ogImage}`
            }
          />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={pageTitle} />
        </>
      )
    }
    <meta
      name="twitter:card"
      content={ogImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {
      ogImage && (
        <meta
          name="twitter:image"
          content={
            ogImage.startsWith("http") ? ogImage : `${siteUrl}${ogImage}`
          }
        />
      )
    }
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: siteTitle,
        url: siteUrl,
        description,
        potentialAction: {
          "@type": "SearchAction",
          target: `${siteUrl}/archive?q={search_term_string}`,
          "query-input": "required name=search_term_string",
        },
      })}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Non-blocking font load: print trick swaps to all once loaded -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <meta
      name="theme-color"
      content="#fdf9f4"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#16120e"
      media="(prefers-color-scheme: dark)"
    />
  </head>
  <body
    class="light"
    style="min-height:100vh;display:flex;flex-direction:column"
  >
    <script is:inline>
      document.body.className = localStorage.getItem("bb-theme") || "light";
    </script>
    <Navbar client:load links={navLinks} />
    <SearchDropdown client:idle />
    <ScrollToTop client:idle />
    <div style="flex:1">
      <slot />
    </div>
    <Footer wordCount={totalWords} />
  </body>
</html>
