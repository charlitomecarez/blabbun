---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="terms" description="Terms, privacy, and help for Blab Bun.">
  <main class="mx-auto min-h-[60vh] w-full max-w-[680px] flex-1 px-8 py-10">
    <div class="animate-[fadeIn_0.2s_ease]">
      <!-- back -->
      <a
        href="/"
        class="mb-7 inline-block text-[0.76rem] text-[var(--accent)] no-underline"
      >
        ← back
      </a>

      <!-- title -->
      <h1 class="mt-5 mb-6 text-[1.05rem] font-semibold">terms</h1>

      <!-- intro -->
      <div
        class="max-w-[540px] space-y-3.5 text-[0.82rem] leading-[1.9] text-[var(--muted)]"
      >
        <p>
          this is a personal blog. i write what i think. that means sometimes
          i'm wrong, sometimes i'm sloppy, and occasionally i write something at
          11pm that probably needed one more edit.
        </p>

        <p>
          by reading this you agree to take everything here with at least a
          small grain of salt. none of this is legal, medical, financial, or
          professional advice of any kind.
        </p>

        <p>
          if something i wrote genuinely bothered you, you're welcome to leave
          an anonymous comment. i read all of them.
        </p>
      </div>

      <!-- sections -->
      <div
        class="mt-8 flex max-w-[540px] flex-col gap-6 border-t border-[var(--divider)] pt-6"
      >
        <!-- privacy -->
        <div>
          <div
            class="mb-2 text-[0.65rem] tracking-[0.07em] text-[var(--muted)] uppercase"
          >
            privacy
          </div>

          <div
            class="space-y-2 text-[0.82rem] leading-[1.9] text-[var(--muted)]"
          >
            <p>
              i don't collect your data. i don't have analytics. i can't see who
              you are or where you're from.
            </p>
            <p>
              if you subscribe to the newsletter, i get your email address and
              nothing else. i won't sell it, share it, or use it for anything
              other than sending you the occasional post.
            </p>
            <p>
              comments are anonymous and stored locally in your browser. they're
              yours.
            </p>
          </div>
        </div>

        <!-- help -->
        <div class="border-t border-[var(--divider)] pt-4">
          <div
            class="mb-2 text-[0.65rem] tracking-[0.07em] text-[var(--muted)] uppercase"
          >
            help
          </div>

          <div
            class="space-y-2 text-[0.82rem] leading-[1.9] text-[var(--muted)]"
          >
            <p>
              got a question? something broken? something you disagree with and
              want to talk about?
            </p>
            <p>
              leave an anonymous comment on any post — it's the best way to
              reach me. i read all of them.
            </p>
            <p>
              if it's something bigger — a bug, something broken, a suggestion —
              <a
                href="/help"
                class="text-[var(--accent)] no-underline hover:underline"
                >report it here</a
              >. you can attach screenshots too.
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
