---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Terms of Service" description="Terms of service for The Lunan.">
  <main class="pt-[64px]">
    <div class="mx-auto max-w-[760px] px-4 py-16 md:px-8 md:py-24">
      <!-- Pill badge -->
      <span
        class="font-manrope mb-6 inline-block rounded-full bg-[#ebf3ed] px-3 py-1 text-[10px] font-bold tracking-[3px] text-[#386547] uppercase"
      >
        Terms
      </span>

      <!-- Heading -->
      <h1
        class="font-space-grotesk text-[38px] leading-[1.05] font-bold tracking-[-0.04em] text-[#29302d] sm:text-[46px] md:text-[52px]"
      >
        Terms of Use
      </h1>

      <!-- Divider -->
      <div class="my-6 h-[2px] w-10 rounded-full bg-[#c5f7d0]"></div>

      <!-- Last updated -->
      <p class="font-manrope mb-10 text-[13px] text-[rgba(41,48,45,0.4)]">
        Last updated: April 2026
      </p>

      <!-- Body -->
      <div class="space-y-8">
        <section>
          <h2
            class="font-space-grotesk mb-3 text-[20px] font-bold tracking-[-0.02em] text-[#29302d]"
          >
            Just reading? You&apos;re fine.
          </h2>
          <p
            class="font-manrope text-[17px] leading-[1.75] text-[rgba(41,48,45,0.65)]"
          >
            This is a personal blog. By reading it, you agree to nothing
            complicated. Browse freely, share things you like, and move on with
            your day.
          </p>
        </section>

        <section>
          <h2
            class="font-space-grotesk mt-4 mb-3 text-[20px] font-bold tracking-[-0.02em] text-[#29302d]"
          >
            Content ownership
          </h2>
          <p
            class="font-manrope text-[17px] leading-[1.75] text-[rgba(41,48,45,0.65)]"
          >
            Everything written here &mdash; essays, thoughts, half-baked ideas
            &mdash; belongs to me. You&apos;re welcome to quote and link with
            credit. Please don&apos;t reproduce full posts elsewhere without
            asking first.
          </p>
        </section>

        <section>
          <h2
            class="font-space-grotesk mt-4 mb-3 text-[20px] font-bold tracking-[-0.02em] text-[#29302d]"
          >
            No warranties
          </h2>
          <p
            class="font-manrope text-[17px] leading-[1.75] text-[rgba(41,48,45,0.65)]"
          >
            The thoughts here are my own, written in good faith, but I&apos;m
            not an expert on everything I write about. Nothing on this site
            constitutes professional advice &mdash; legal, medical, financial,
            or otherwise. Use your own judgment.
          </p>
        </section>

        <section>
          <h2
            class="font-space-grotesk mt-4 mb-3 text-[20px] font-bold tracking-[-0.02em] text-[#29302d]"
          >
            External links
          </h2>
          <p
            class="font-manrope text-[17px] leading-[1.75] text-[rgba(41,48,45,0.65)]"
          >
            Posts sometimes link to other sites. I&apos;m not responsible for
            their content, availability, or what they do with your data once you
            leave here.
          </p>
        </section>

        <section>
          <h2
            class="font-space-grotesk mt-4 mb-3 text-[20px] font-bold tracking-[-0.02em] text-[#29302d]"
          >
            Changes
          </h2>
          <p
            class="font-manrope text-[17px] leading-[1.75] text-[rgba(41,48,45,0.65)]"
          >
            These terms may change as the site evolves. If something shifts
            meaningfully, I&apos;ll update the date above.
          </p>
        </section>
      </div>

      <!-- Footer nav -->
      <div class="mt-14 border-t border-[rgba(197,247,208,0.4)] pt-8">
        <a
          href="/"
          class="font-manrope group inline-flex items-center gap-2 text-[13px] font-semibold text-[rgba(41,48,45,0.5)] transition-colors hover:text-[#386547]"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 14 14"
            fill="none"
            aria-hidden="true"
            class="transition-transform group-hover:-translate-x-0.5"
          >
            <path
              d="M13 7H1M6 2L1 7l5 5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          Back home
        </a>
      </div>
    </div>
  </main>
</Layout>
