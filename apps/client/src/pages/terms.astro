---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="terms" description="Terms, privacy, and help for Blab Bun.">
  <main
    class="mx-auto min-h-[60vh] w-full max-w-[680px] flex-1 px-4 py-6 sm:px-8 sm:py-10"
  >
    <div style="animation:fadeIn 0.2s ease">
      <!-- back -->
      <a
        href="/?utm_source=terms&utm_medium=internal&utm_campaign=back_nav"
        style="color:var(--accent);font-family:'Caveat',cursive;font-size:1.1rem;
               text-decoration:none;padding:0;display:inline-block;margin-bottom:24px"
      >
        ← back to the blabs
      </a>

      <!-- title row: "terms" + "(the boring page)" inline -->
      <div
        style="display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin-bottom:8px"
      >
        <h1
          style="font-family:'Fraunces',serif;font-size:2.4rem;font-weight:600;letter-spacing:-0.02em"
        >
          terms
        </h1>
        <span
          style="font-family:'Caveat',cursive;font-size:1.2rem;color:var(--accent);
                     transform:rotate(-3deg);display:inline-block"
        >
          (the boring page)
        </span>
      </div>

      <!-- scribble underline -->
      <svg
        width="180"
        height="14"
        viewBox="0 0 180 14"
        style="margin-bottom:28px;display:block"
      >
        <path
          d="M2 8 Q 30 2, 60 8 T 120 8 T 178 7"
          stroke="var(--accent)"
          stroke-width="2"
          fill="none"
          stroke-linecap="round"></path>
      </svg>

      <!-- content -->
      <div
        style="font-size:0.9rem;color:var(--muted);line-height:1.95;max-width:580px"
      >
        <p style="margin-bottom:14px">
          this is a personal blog. i write what i think. that means sometimes
          i'm wrong, sometimes i'm sloppy, and occasionally i write something at
          11pm that probably needed one more edit.
        </p>
        <p style="margin-bottom:14px">
          by reading this you agree to take everything here with at least a
          small grain of salt. none of this is legal, medical, financial, or
          professional advice of any kind.
        </p>
        <p style="margin-bottom:28px">
          if something i wrote genuinely bothered you, you're welcome to leave
          an anonymous comment. i read all of them.
        </p>

        <!-- sections -->
        <div
          style="border-top:1px solid var(--divider);padding-top:24px;
                    display:flex;flex-direction:column;gap:16px"
        >
          <!-- privacy -->
          <div>
            <div
              style="font-size:0.65rem;letter-spacing:0.07em;text-transform:uppercase;
                        margin-bottom:8px;color:var(--muted)"
            >
              privacy
            </div>
            <p style="margin-bottom:8px">
              this site uses Google Analytics (GA4) for basic traffic stats —
              page views, referrers, that kind of thing. GA uses cookies. no
              personally identifiable info is collected beyond what GA does by
              default.
            </p>
            <p style="margin-bottom:8px">
              if you subscribe to the newsletter, i store your email address and
              nothing else. i won't sell it, share it, or use it for anything
              other than sending you the occasional post. unsubscribe any time.
            </p>
            <p>
              comments are anonymous and stored server-side. claps use a one-way
              hash of your IP to prevent duplicates — the raw address is never
              stored. full details on the <a
                href="/privacy"
                style="color:var(--accent);text-decoration:none">privacy page</a
              >.
            </p>
          </div>

          <!-- help -->
          <div style="border-top:1px solid var(--divider);padding-top:16px">
            <div
              style="font-size:0.65rem;letter-spacing:0.07em;text-transform:uppercase;
                        margin-bottom:8px;color:var(--muted)"
            >
              help
            </div>
            <p style="margin-bottom:8px">
              got a question? something broken? something you disagree with and
              want to talk about?
            </p>
            <p style="margin-bottom:8px">
              leave an anonymous comment on any post — it's the best way to
              reach me. i read all of them.
            </p>
            <p>
              if it's something bigger — a bug, something broken, a suggestion —
              <a href="/help" style="color:var(--accent);text-decoration:none"
                >report it here</a
              >. you can attach screenshots too.
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <style>
    @media (max-width: 640px) {
      h1 {
        font-size: 1.75rem !important;
      }
    }
  </style>
</Layout>
