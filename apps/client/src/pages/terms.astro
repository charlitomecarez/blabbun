---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="terms" description="Terms, privacy, and help for Blab Bun.">
  <main
    style="max-width:680px;margin:0 auto;padding:32px 32px;width:100%;flex:1;min-height:60vh"
  >
    <div style="animation:fadeIn 0.2s ease">
      <a
        href="/"
        style="background:none;border:none;color:var(--accent);font-size:0.76rem;cursor:pointer;font-family:inherit;padding:0;margin-bottom:28px;display:inline-block;text-decoration:none"
      >
        ← back
      </a>
      <h1
        style="font-size:1.05rem;font-weight:600;margin-bottom:24px;margin-top:20px"
      >
        terms
      </h1>
      <div
        style="font-size:0.82rem;color:var(--muted);line-height:1.9;max-width:540px"
      >
        <p style="margin-bottom:14px">
          this is a personal blog. i write what i think. that means sometimes
          i'm wrong, sometimes i'm sloppy, and occasionally i write something at
          11pm that probably needed one more edit.
        </p>
        <p style="margin-bottom:14px">
          by reading this you agree to take everything here with at least a
          small grain of salt. none of this is legal, medical, financial, or
          professional advice of any kind.
        </p>
        <p style="margin-bottom:28px">
          if something i wrote genuinely bothered you, you're welcome to leave
          an anonymous comment. i read all of them.
        </p>

        <div
          style="border-top:1px solid var(--divider);padding-top:24px;display:flex;flex-direction:column;gap:16px"
        >
          <div>
            <div
              style="font-size:0.65rem;letter-spacing:0.07em;text-transform:uppercase;margin-bottom:8px;color:var(--muted)"
            >
              privacy
            </div>
            <p style="margin-bottom:8px">
              i don't collect your data. i don't have analytics. i can't see who
              you are or where you're from.
            </p>
            <p style="margin-bottom:8px">
              if you subscribe to the newsletter, i get your email address and
              nothing else. i won't sell it, share it, or use it for anything
              other than sending you the occasional post.
            </p>
            <p>
              comments are anonymous and stored locally in your browser. they're
              yours.
            </p>
          </div>
          <div style="border-top:1px solid var(--divider);padding-top:16px">
            <div
              style="font-size:0.65rem;letter-spacing:0.07em;text-transform:uppercase;margin-bottom:8px;color:var(--muted)"
            >
              help
            </div>
            <p style="margin-bottom:8px">
              got a question? something broken? something you disagree with and
              want to talk about?
            </p>
            <p style="margin-bottom:8px">
              leave an anonymous comment on any post — it's the best way to
              reach me. i read all of them.
            </p>
            <p>
              if it's something bigger, you can probably find me on the internet
              somewhere. i'm not hard to locate if you actually look.
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
