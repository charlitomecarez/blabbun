---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="404 — not found" description="This page doesn't exist.">
  <main
    class="mx-auto flex min-h-[60vh] w-full max-w-[680px] flex-1 flex-col justify-center px-8"
  >
    <div class="animate-[fadeIn_0.2s_ease]">
      <div
        class="mb-4 text-[0.68rem] tracking-[0.06em] text-[var(--muted)] uppercase"
      >
        404
      </div>

      <h1
        class="mb-3 text-[1.05rem] leading-[1.4] font-semibold text-[var(--text)]"
      >
        this page doesn't exist.
      </h1>

      <p
        class="mb-8 max-w-[420px] text-[0.84rem] leading-[1.8] text-pretty text-[var(--muted)]"
      >
        it might've been moved, deleted, or never existed in the first place.
        either way, it's not here now.
      </p>

      <div class="flex flex-wrap gap-3">
        <a
          href="/"
          class="rounded-[3px] border border-[var(--accent)] px-[14px] py-[7px] text-[0.78rem] text-[var(--accent)] no-underline transition-colors duration-150 hover:bg-[var(--accent-soft)]"
        >
          ← go home
        </a>

        <a
          href="/archive"
          class="rounded-[3px] border border-[var(--border)] px-[14px] py-[7px] text-[0.78rem] text-[var(--muted)] no-underline transition-colors duration-150 hover:bg-[var(--bg2)]"
        >
          browse all posts
        </a>
      </div>
    </div>
  </main>
</Layout>
