---
import Layout from "@/layouts/Layout.astro";
import { getRuntimeEnv, getSupabaseClient } from "@/lib/api";
import { verifyUnsubscribeToken } from "@/lib/unsubscribe";

export const prerender = false;

const runtimeEnv = getRuntimeEnv(Astro.locals);
const secret: string =
  runtimeEnv.UNSUBSCRIBE_SECRET ?? import.meta.env.UNSUBSCRIBE_SECRET ?? "";

const url = new URL(Astro.request.url);
const done = url.searchParams.get("done") === "true";

let email = url.searchParams.get("email") ?? "";
let token = url.searchParams.get("token") ?? "";
let formError = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  email = form.get("email")?.toString() ?? "";
  token = form.get("token")?.toString() ?? "";

  if (!secret || !verifyUnsubscribeToken(email, token, secret)) {
    formError = "This unsubscribe link is invalid or has expired.";
  } else {
    const supabase = getSupabaseClient(
      runtimeEnv.SUPABASE_URL ?? import.meta.env.SUPABASE_URL,
      runtimeEnv.SUPABASE_SERVICE_ROLE_KEY ??
        import.meta.env.SUPABASE_SERVICE_ROLE_KEY
    );
    await supabase.from("subscribers").delete().eq("email", email);
    return Astro.redirect("/unsubscribe?done=true");
  }
}

const validLink =
  !done &&
  email &&
  token &&
  secret &&
  verifyUnsubscribeToken(email, token, secret);
---

<Layout title="unsubscribe" description="Manage your subscription to blab bun.">
  <main
    class="mx-auto flex min-h-[60vh] w-full max-w-[680px] flex-1 flex-col justify-center px-8"
  >
    <div class="animate-[fadeIn_0.2s_ease]">
      {
        done ? (
          <>
            <div class="mb-4 text-[0.68rem] tracking-[0.06em] text-[var(--muted)] uppercase">
              unsubscribed
            </div>

            <h1 class="mb-3 text-[1.2rem] leading-[1.4] font-semibold text-[var(--text)]">
              you're out.
            </h1>

            <p class="mb-8 max-w-[440px] text-[0.84rem] leading-[1.8] text-pretty text-[var(--muted)]">
              you won't hear from blab bun again. no confirmation emails, no
              "we'll miss you" sequence. just silence.
            </p>

            <a
              href="/"
              class="inline-block rounded-[3px] border border-[var(--accent)] px-[14px] py-[7px] text-[0.78rem] text-[var(--accent)] no-underline transition-colors hover:bg-[var(--accent-soft)]"
            >
              ← go home
            </a>
          </>
        ) : validLink ? (
          <>
            <div class="mb-4 text-[0.68rem] tracking-[0.06em] text-[var(--muted)] uppercase">
              unsubscribe
            </div>

            <h1 class="mb-3 text-[1.2rem] leading-[1.4] font-semibold text-[var(--text)]">
              leave the list?
            </h1>

            <p class="mb-2 max-w-[440px] text-[0.84rem] leading-[1.8] text-pretty text-[var(--muted)]">
              this will remove{" "}
              <strong class="font-medium text-[var(--text)]">{email}</strong>{" "}
              from the blab bun mailing list.
            </p>

            <p class="mb-8 max-w-[440px] text-[0.84rem] leading-[1.8] text-pretty text-[var(--muted)]">
              no hard feelings. you can always resubscribe from the homepage.
            </p>

            {formError && (
              <p class="mb-5 text-[0.78rem] leading-[1.6] text-red-600">
                {formError}
              </p>
            )}

            <form class="flex flex-wrap gap-3" method="POST">
              <input type="hidden" name="email" value={email} />
              <input type="hidden" name="token" value={token} />

              <button
                type="submit"
                class="font-inherit cursor-pointer rounded-[3px] border-none bg-[#c4832a] px-[18px] py-[8px] text-[0.78rem] text-white transition-opacity hover:opacity-80"
              >
                yes, unsubscribe me
              </button>

              <a
                href="/"
                class="rounded-[3px] border border-[var(--border)] px-[14px] py-[7px] text-[0.78rem] text-[var(--muted)] no-underline transition-colors hover:bg-[var(--bg2)]"
              >
                never mind
              </a>
            </form>
          </>
        ) : (
          <>
            <div class="mb-4 text-[0.68rem] tracking-[0.06em] text-[var(--muted)] uppercase">
              invalid link
            </div>

            <h1 class="mb-3 text-[1.2rem] leading-[1.4] font-semibold text-[var(--text)]">
              this link doesn't work.
            </h1>

            <p class="mb-8 max-w-[440px] text-[0.84rem] leading-[1.8] text-pretty text-[var(--muted)]">
              it's either expired, malformed, or you got here by accident. try
              clicking the unsubscribe link directly from the email.
            </p>

            <a
              href="/"
              class="inline-block rounded-[3px] border border-[var(--accent)] px-[14px] py-[7px] text-[0.78rem] text-[var(--accent)] no-underline transition-colors hover:bg-[var(--accent-soft)]"
            >
              ← go home
            </a>
          </>
        )
      }
    </div>
  </main>
</Layout>
