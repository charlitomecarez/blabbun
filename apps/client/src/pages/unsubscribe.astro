---
import Layout from "@/layouts/Layout.astro";
import { getAppEnv, getRuntimeEnv, getSupabaseClient } from "@/lib/api";
import { verifyUnsubscribeToken } from "@/lib/unsubscribe";

export const prerender = false;

const runtimeEnv = getRuntimeEnv(Astro.locals);
const appEnv = getAppEnv(runtimeEnv);
const secret: string =
  runtimeEnv.UNSUBSCRIBE_SECRET ?? import.meta.env.UNSUBSCRIBE_SECRET ?? "";

const url = new URL(Astro.request.url);
const done = url.searchParams.get("done") === "true";

let email = url.searchParams.get("email") ?? "";
let token = url.searchParams.get("token") ?? "";
let formError = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  email = form.get("email")?.toString() ?? "";
  token = form.get("token")?.toString() ?? "";

  if (!secret || !verifyUnsubscribeToken(email, token, secret)) {
    formError = "This unsubscribe link is invalid or has expired.";
  } else {
    const supabase = getSupabaseClient(
      runtimeEnv.SUPABASE_URL ?? import.meta.env.SUPABASE_URL,
      runtimeEnv.SUPABASE_SERVICE_ROLE_KEY ??
        import.meta.env.SUPABASE_SERVICE_ROLE_KEY
    );
    await supabase
      .from("subscribers")
      .delete()
      .eq("env", appEnv)
      .eq("email", email);
    return Astro.redirect("/unsubscribe?done=true");
  }
}

const validLink =
  !done &&
  email &&
  token &&
  secret &&
  verifyUnsubscribeToken(email, token, secret);
---

<Layout title="unsubscribe" description="Manage your subscription to blab bun.">
  <main
    class="mx-auto min-h-[60vh] w-full max-w-[680px] flex-1 px-4 py-6 sm:px-8 sm:py-10"
  >
    <div style="animation:fadeIn 0.2s ease">
      {
        done ? (
          <>
            <a
              href="/?utm_source=unsubscribe&utm_medium=internal&utm_campaign=unsubscribed"
              style="color:var(--accent);font-family:'Caveat',cursive;font-size:1.1rem;
                     text-decoration:none;padding:0;display:inline-block;margin-bottom:24px"
            >
              ← back to the blabs
            </a>

            <div style="display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin-bottom:8px">
              <h1 style="font-family:'Fraunces',serif;font-size:2.4rem;font-weight:600;letter-spacing:-0.02em">
                you're out.
              </h1>
              <span
                style="font-family:'Caveat',cursive;font-size:1.2rem;color:var(--accent);
                           transform:rotate(-3deg);display:inline-block"
              >
                all good ✶
              </span>
            </div>

            <svg
              width="140"
              height="14"
              viewBox="0 0 140 14"
              style="margin-bottom:28px;display:block"
            >
              <path
                d="M2 8 Q 24 2, 48 8 T 96 8 T 138 7"
                stroke="var(--accent)"
                stroke-width="2"
                fill="none"
                stroke-linecap="round"
              />
            </svg>

            <p style="font-size:0.88rem;color:var(--muted);line-height:1.85;max-width:440px;margin-bottom:32px">
              you won't hear from blab bun again. no confirmation emails, no
              "we'll miss you" sequence. just silence.
            </p>

            <a
              href="/?utm_source=unsubscribe&utm_medium=internal&utm_campaign=unsubscribed"
              style="display:inline-block;border:1.5px solid var(--accent);
                     padding:7px 18px;border-radius:3px;font-size:0.78rem;
                     color:var(--accent);text-decoration:none;
                     transition:background 0.15s"
              onmouseenter="this.style.background='var(--accent-soft)'"
              onmouseleave="this.style.background='transparent'"
            >
              ← go home
            </a>
          </>
        ) : validLink ? (
          <>
            <a
              href="/?utm_source=unsubscribe&utm_medium=internal&utm_campaign=unsubscribe_pending"
              style="color:var(--accent);font-family:'Caveat',cursive;font-size:1.1rem;
                     text-decoration:none;padding:0;display:inline-block;margin-bottom:24px"
            >
              ← back to the blabs
            </a>

            <div style="display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin-bottom:8px">
              <h1 style="font-family:'Fraunces',serif;font-size:2.4rem;font-weight:600;letter-spacing:-0.02em">
                leave the list?
              </h1>
              <span
                style="font-family:'Caveat',cursive;font-size:1.2rem;color:var(--accent);
                           transform:rotate(-3deg);display:inline-block"
              >
                no hard feelings
              </span>
            </div>

            <svg
              width="200"
              height="14"
              viewBox="0 0 200 14"
              style="margin-bottom:28px;display:block"
            >
              <path
                d="M2 8 Q 34 2, 68 8 T 136 8 T 198 7"
                stroke="var(--accent)"
                stroke-width="2"
                fill="none"
                stroke-linecap="round"
              />
            </svg>

            <p style="font-size:0.88rem;color:var(--muted);line-height:1.85;max-width:440px;margin-bottom:10px">
              this will remove{" "}
              <strong style="font-weight:500;color:var(--text)">{email}</strong>{" "}
              from the blab bun mailing list.
            </p>
            <p style="font-size:0.88rem;color:var(--muted);line-height:1.85;max-width:440px;margin-bottom:28px">
              you can always resubscribe from the homepage.
            </p>

            {formError && (
              <p style="font-size:0.78rem;color:var(--accent2);line-height:1.6;margin-bottom:20px">
                {formError}
              </p>
            )}

            <form style="display:flex;flex-wrap:wrap;gap:12px" method="POST">
              <input type="hidden" name="email" value={email} />
              <input type="hidden" name="token" value={token} />

              <button
                type="submit"
                style="background:var(--accent);border:none;border-radius:3px;
                       padding:8px 20px;font-size:0.78rem;font-family:inherit;
                       color:#fff;cursor:pointer;transition:opacity 0.15s;letter-spacing:0.02em"
                onmouseenter="this.style.opacity='0.85'"
                onmouseleave="this.style.opacity='1'"
              >
                yes, unsubscribe me
              </button>

              <a
                href="/?utm_source=unsubscribe&utm_medium=internal&utm_campaign=never_mind"
                style="display:inline-flex;align-items:center;border:1px solid var(--border);
                       border-radius:3px;padding:8px 16px;font-size:0.78rem;
                       color:var(--muted);text-decoration:none;transition:background 0.15s"
                onmouseenter="this.style.background='var(--bg2)'"
                onmouseleave="this.style.background='transparent'"
              >
                never mind
              </a>
            </form>
          </>
        ) : (
          <>
            <a
              href="/?utm_source=unsubscribe&utm_medium=internal&utm_campaign=invalid_link"
              style="color:var(--accent);font-family:'Caveat',cursive;font-size:1.1rem;
                     text-decoration:none;padding:0;display:inline-block;margin-bottom:24px"
            >
              ← back to the blabs
            </a>

            <div style="display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin-bottom:8px">
              <h1 style="font-family:'Fraunces',serif;font-size:2.4rem;font-weight:600;letter-spacing:-0.02em">
                broken link.
              </h1>
              <span
                style="font-family:'Caveat',cursive;font-size:1.2rem;color:var(--accent);
                           transform:rotate(-3deg);display:inline-block"
              >
                hm.
              </span>
            </div>

            <svg
              width="120"
              height="14"
              viewBox="0 0 120 14"
              style="margin-bottom:28px;display:block"
            >
              <path
                d="M2 8 Q 20 2, 40 8 T 80 8 T 118 7"
                stroke="var(--accent)"
                stroke-width="2"
                fill="none"
                stroke-linecap="round"
              />
            </svg>

            <p style="font-size:0.88rem;color:var(--muted);line-height:1.85;max-width:440px;margin-bottom:32px">
              this link is either expired, malformed, or you got here by
              accident. try clicking the unsubscribe link directly from the
              email.
            </p>

            <a
              href="/?utm_source=unsubscribe&utm_medium=internal&utm_campaign=invalid_link"
              style="display:inline-block;border:1.5px solid var(--accent);
                     padding:7px 18px;border-radius:3px;font-size:0.78rem;
                     color:var(--accent);text-decoration:none;
                     transition:background 0.15s"
              onmouseenter="this.style.background='var(--accent-soft)'"
              onmouseleave="this.style.background='transparent'"
            >
              ← go home
            </a>
          </>
        )
      }
    </div>
  </main>

  <style>
    @media (max-width: 640px) {
      h1 {
        font-size: 1.75rem !important;
      }
    }
  </style>
</Layout>
