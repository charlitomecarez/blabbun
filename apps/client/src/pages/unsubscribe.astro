---
import Layout from "@/layouts/Layout.astro";
import { getSupabaseClient } from "@/lib/api";
import { verifyUnsubscribeToken } from "@/lib/unsubscribe";

export const prerender = false;

const url = new URL(Astro.request.url);
const done = url.searchParams.get("done") === "true";

let email = url.searchParams.get("email") ?? "";
let token = url.searchParams.get("token") ?? "";
let formError = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  email = form.get("email")?.toString() ?? "";
  token = form.get("token")?.toString() ?? "";

  const secret = import.meta.env.UNSUBSCRIBE_SECRET as string;
  if (!secret || !verifyUnsubscribeToken(email, token, secret)) {
    formError = "This unsubscribe link is invalid or has expired.";
  } else {
    const supabase = getSupabaseClient();
    await supabase.from("subscribers").delete().eq("email", email);
    return Astro.redirect("/unsubscribe?done=true");
  }
}

const secret = import.meta.env.UNSUBSCRIBE_SECRET as string;
const validLink =
  !done &&
  email &&
  token &&
  secret &&
  verifyUnsubscribeToken(email, token, secret);
---

<Layout title="unsubscribe" description="Manage your subscription to blab bun.">
  <main
    style="max-width:680px;margin:0 auto;padding:32px 32px;width:100%;flex:1;min-height:60vh;display:flex;flex-direction:column;justify-content:center"
  >
    <div style="animation:fadeIn 0.2s ease">
      {
        done ? (
          <>
            <div style="font-size:0.68rem;color:var(--muted);letter-spacing:0.06em;text-transform:uppercase;margin-bottom:16px">
              unsubscribed
            </div>
            <h1 style="font-size:1.2rem;font-weight:600;color:var(--text);margin-bottom:12px;line-height:1.4">
              you're out.
            </h1>
            <p style="font-size:0.84rem;color:var(--muted);line-height:1.8;margin-bottom:32px;max-width:440px;text-wrap:pretty">
              you won't hear from blab bun again. no confirmation emails, no
              "we'll miss you" sequence. just silence.
            </p>
            <div style="display:flex;gap:12px;flex-wrap:wrap">
              <a
                href="/"
                style="font-size:0.78rem;color:var(--accent);text-decoration:none;border:1px solid var(--accent);border-radius:3px;padding:7px 14px;transition:background 0.15s"
                onmouseenter="this.style.background='var(--accent-soft)'"
                onmouseleave="this.style.background='transparent'"
              >
                ← go home
              </a>
            </div>
          </>
        ) : validLink ? (
          <>
            <div style="font-size:0.68rem;color:var(--muted);letter-spacing:0.06em;text-transform:uppercase;margin-bottom:16px">
              unsubscribe
            </div>
            <h1 style="font-size:1.2rem;font-weight:600;color:var(--text);margin-bottom:12px;line-height:1.4">
              leave the list?
            </h1>
            <p style="font-size:0.84rem;color:var(--muted);line-height:1.8;margin-bottom:8px;max-width:440px;text-wrap:pretty">
              this will remove{" "}
              <strong style="color:var(--text);font-weight:500">{email}</strong>{" "}
              from the blab bun mailing list.
            </p>
            <p style="font-size:0.84rem;color:var(--muted);line-height:1.8;margin-bottom:32px;max-width:440px;text-wrap:pretty">
              no hard feelings. you can always resubscribe from the homepage.
            </p>
            {formError && (
              <p style="font-size:0.78rem;color:#c0392b;margin-bottom:20px;line-height:1.6">
                {formError}
              </p>
            )}
            <form method="POST" style="display:flex;gap:12px;flex-wrap:wrap">
              <input type="hidden" name="email" value={email} />
              <input type="hidden" name="token" value={token} />
              <button
                type="submit"
                style="font-size:0.78rem;font-family:inherit;cursor:pointer;background:#c4832a;color:#fff;border:none;border-radius:3px;padding:8px 18px;transition:opacity 0.15s;letter-spacing:0.02em"
                onmouseenter="this.style.opacity='0.85'"
                onmouseleave="this.style.opacity='1'"
              >
                yes, unsubscribe me
              </button>
              <a
                href="/"
                style="font-size:0.78rem;color:var(--muted);text-decoration:none;border:1px solid var(--border);border-radius:3px;padding:7px 14px;transition:background 0.15s"
                onmouseenter="this.style.background='var(--bg2)'"
                onmouseleave="this.style.background='transparent'"
              >
                never mind
              </a>
            </form>
          </>
        ) : (
          <>
            <div style="font-size:0.68rem;color:var(--muted);letter-spacing:0.06em;text-transform:uppercase;margin-bottom:16px">
              invalid link
            </div>
            <h1 style="font-size:1.2rem;font-weight:600;color:var(--text);margin-bottom:12px;line-height:1.4">
              this link doesn't work.
            </h1>
            <p style="font-size:0.84rem;color:var(--muted);line-height:1.8;margin-bottom:32px;max-width:440px;text-wrap:pretty">
              it's either expired, malformed, or you got here by accident. try
              clicking the unsubscribe link directly from the email.
            </p>
            <a
              href="/"
              style="font-size:0.78rem;color:var(--accent);text-decoration:none;border:1px solid var(--accent);border-radius:3px;padding:7px 14px;transition:background 0.15s;display:inline-block"
              onmouseenter="this.style.background='var(--accent-soft)'"
              onmouseleave="this.style.background='transparent'"
            >
              ← go home
            </a>
          </>
        )
      }
    </div>
  </main>
</Layout>
