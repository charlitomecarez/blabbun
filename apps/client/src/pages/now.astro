---
import Layout from "@/layouts/Layout.astro";

const items = [
  {
    section: "reading",
    entries: [
      "a book i started months ago and now we’re just in a situationship",
      "articles explaining why everything is bad and somehow still getting worse",
      "ancient blog posts from people who escaped the internet and are probably happier than me",
    ],
  },
  {
    section: "thinking about",
    entries: [
      "if having fewer opinions would bring me peace or just make me boring as hell",
      "how group chats are slowly dying and everyone is pretending it’s normal",
      "why finishing things feels like a personality trait now instead of just… doing it",
    ],
  },
  {
    section: "current mood",
    entries: [
      "tired but like… spiritually productive tired",
      "vaguely annoyed at something i haven’t figured out yet (future post loading...)",
    ],
  },
  {
    section: "lately",
    entries: [
      "writing more than usual which is either growth or advanced procrastination",
      "drinking concerning amounts of coffee and calling it character development",
      "fighting the overwhelming urge to redesign this entire blog again for no reason",
    ],
  },
];
---

<Layout
  title="Now — Blab Bun"
  description="What the blabbun writer is reading, thinking about, and doing right now — a living snapshot, updated periodically."
>
  <main class="mx-auto min-h-[60vh] w-full max-w-[680px] flex-1 px-8 py-10">
    <div class="animate-[fadeIn_0.2s_ease]">
      <!-- back -->
      <a
        href="/"
        class="mb-8 inline-block text-[0.76rem] text-[var(--accent)] no-underline"
      >
        ← back
      </a>

      <!-- header -->
      <div class="mt-5 mb-8">
        <h1 class="mb-1.5 text-[1.1rem] font-semibold text-[var(--text)]">
          now
        </h1>

        <div class="text-[0.7rem] text-[var(--muted)]">
          a snapshot of what's going on — updated Apr 2026 ·{" "}
          <a
            href="https://nownownow.com/about"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--accent)] no-underline"
          >
            what is a /now page?
          </a>
        </div>
      </div>

      <!-- sections -->
      <div class="flex max-w-[560px] flex-col gap-9">
        {
          items.map(({ section, entries }) => (
            <div>
              <div class="mb-3.5 border-b border-[var(--divider)] pb-2 text-[0.65rem] tracking-[0.08em] text-[var(--muted)] uppercase">
                {section}
              </div>

              <div class="flex flex-col gap-2.5">
                {entries.map((entry) => (
                  <div class="flex items-start gap-3">
                    <span class="mt-[2px] flex-shrink-0 text-[0.8rem] text-[var(--accent)]">
                      —
                    </span>

                    <p class="text-[0.84rem] leading-[1.7] text-[var(--muted)]">
                      {entry}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <!-- footer -->
      <div
        class="mt-12 border-t border-[var(--divider)] pt-6 text-[0.68rem] text-[var(--muted)]"
      >
        inspired by{" "}
        <a
          href="https://nownownow.com"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[var(--accent)] no-underline"
        >
          nownownow.com
        </a>
        {" "}— the /now page movement
      </div>
    </div>
  </main>
</Layout>
