---
import { PostHero } from "@blabbun/ui/components/cards";
import {
  BookmarkButton,
  ReactionBar,
  ReadingProgress,
} from "@blabbun/ui/components/post";
import { tagClass } from "@blabbun/utils";
import { getCollection, render } from "astro:content";
import { shuffle } from "lodash-es";

import ClapShare from "@/components/post/ClapShare.svelte";
import Comments from "@/components/post/Comments.svelte";
import Layout from "@/layouts/Layout.astro";
import { fetchPostStats } from "@/lib/stats";

const { slug } = Astro.params;
const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const post = allPosts.find((p) => p.id === slug);

if (!post) return new Response(null, { status: 404 });

const { Content } = await render(post);

const wordCount = post.body?.trim().split(/\s+/).length ?? 0;
const readTime = `${Math.max(1, Math.round(wordCount / 200))} min read`;
const tag = (post.data.tags?.[0] ?? "EDITORIAL").toUpperCase();
const postUrl = `${Astro.site ?? "https://blabbun.com"}/${post.id}`;
const hasImage = !!post.data.image;

const otherPosts = allPosts.filter((p) => p.id !== post.id);
const relatedSlice = shuffle(otherPosts).slice(0, 3);
const relatedStats = await fetchPostStats(relatedSlice.map((p) => p.id));

const relatedPosts = relatedSlice.map((p) => ({
  title: p.data.title,
  excerpt: p.data.description,
  tag: (p.data.tags?.[0] ?? "EDITORIAL").toUpperCase(),
  href: `/${p.id}`,
  date: p.data.pubDate.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }),
  claps: relatedStats[p.id]?.claps,
  commentCount: relatedStats[p.id]?.commentCount,
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  url: postUrl,
  datePublished: post.data.pubDate.toISOString(),
  author: {
    "@type": "Person",
    name: "Blab Bun",
    url: `${Astro.site ?? "https://blabbun.com"}/about`,
  },
  publisher: {
    "@type": "Organization",
    name: "Blab Bun",
    url: Astro.site ?? "https://blabbun.com",
  },
  ...(post.data.image ? { image: post.data.image } : {}),
};
---

<Layout
  title={post.data.title}
  description={post.data.description}
  ogImage={post.data.image}
>
  <ReadingProgress client:load />

  <main
    style="max-width:680px;margin:0 auto;padding:32px 32px;width:100%;flex:1;min-height:60vh"
  >
    <!-- Post header (matches PostDetailView) -->
    <PostHero
      title={post.data.title}
      tag={tag}
      readTime={readTime}
      pubDate={post.data.pubDate}
      backHref="/"
    />

    <!-- Optional image -->
    {
      hasImage && (
        <div style="margin-bottom:24px">
          <img
            src={post.data.image}
            alt={post.data.title}
            width="616"
            height="280"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            style="width:100%;border-radius:3px;object-fit:cover;max-height:280px"
          />
          {post.data.imageSource && (
            <p style="font-size:0.62rem;text-align:right;margin-top:4px;color:var(--muted2)">
              image:{" "}
              {post.data.imageSourceUrl ? (
                <a
                  href={post.data.imageSourceUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  style="color:var(--accent)"
                >
                  {post.data.imageSource}
                </a>
              ) : (
                post.data.imageSource
              )}
            </p>
          )}
        </div>
      )
    }

    <!-- Article body — matches design's content paragraphs -->
    <div style="border-top:1px solid var(--divider);padding-top:26px">
      <div
        class="prose prose-p:font-mono prose-p:text-[0.88rem] prose-p:leading-[1.9] prose-p:mb-5 prose-p:text-[var(--muted)] prose-p:text-wrap-pretty prose-headings:font-mono prose-headings:font-semibold prose-headings:text-[var(--text)] prose-h2:text-[1.1rem] prose-h2:mt-10 prose-h2:mb-4 prose-h3:text-[0.95rem] prose-h3:mt-7 prose-h3:mb-3 prose-a:text-[var(--accent)] prose-a:no-underline hover:prose-a:underline prose-strong:text-[var(--text)] prose-strong:font-semibold prose-ul:pl-6 prose-ol:pl-6 prose-li:text-[0.88rem] prose-li:text-[var(--muted)] prose-li:leading-[1.9] prose-li:my-1 prose-code:font-mono prose-code:text-[var(--text)] prose-code:bg-[var(--bg2)] prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-code:text-[0.82em] prose-pre:bg-[var(--bg2)] prose-pre:text-[var(--text)] prose-pre:rounded prose-pre:overflow-x-auto prose-pre:text-[0.82em] prose-blockquote:border-l-2 prose-blockquote:border-[var(--accent)] prose-blockquote:bg-[var(--bg2)] prose-blockquote:px-4 prose-blockquote:py-1 prose-blockquote:text-[var(--muted)] prose-blockquote:not-italic prose-hr:border-[var(--divider)] prose-hr:my-8 prose-img:rounded max-w-none"
      >
        <Content />
      </div>
    </div>

    <!-- Reactions -->
    <ReactionBar client:visible postSlug={post.id} />

    <!-- Actions: ClapButton + SharePanel + 🔖 (margin-left:auto) — exact PostDetailView layout -->
    <div
      style="display:flex;align-items:center;gap:14px;margin-top:28px;padding-top:24px;border-top:1px solid var(--divider);flex-wrap:wrap"
    >
      <ClapShare
        client:visible
        postSlug={post.id}
        postUrl={postUrl}
        postTitle={post.data.title}
      >
        <BookmarkButton
          client:visible
          slug={post.id}
          style="margin-left:auto;font-size:1.1rem"
        />
      </ClapShare>
    </div>

    <!-- Comments -->
    <Comments client:visible postSlug={post.id} />

    <!-- Related posts -->
    {
      relatedPosts.length > 0 && (
        <div style="margin-top:48px;padding-top:24px;border-top:1px solid var(--divider)">
          <div style="font-size:0.72rem;color:var(--muted);letter-spacing:0.06em;margin-bottom:20px;text-transform:uppercase">
            more from blab bun
          </div>
          <div>
            {relatedPosts.map((p) => (
              <div class="rel-row">
                <a
                  href={p.href}
                  class="absolute inset-0 z-0"
                  aria-label={p.title}
                />

                <div style="display:flex;gap:8px;align-items:center;margin-bottom:5px">
                  <span style="font-size:0.65rem;color:var(--muted)">
                    {p.date}
                  </span>
                  <span class={`rel-badge ${tagClass(p.tag)}`}>{p.tag}</span>
                </div>

                <div class="rel-title">{p.title}</div>
              </div>
            ))}
          </div>
        </div>
      )
    }
  </main>

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  <style>
    /* ─── Related posts hover ──────────────────────────────────── */
    .rel-row {
      padding: 14px 0;
      border-bottom: 1px solid var(--divider);
      cursor: pointer;
      position: relative;
    }
    .rel-title {
      font-size: 0.84rem;
      font-weight: 500;
      line-height: 1.45;
      color: var(--text);
      transition: color 0.15s;
      text-wrap: pretty;
    }
    .rel-row:hover .rel-title {
      color: var(--accent);
    }

    /* ─── Small tag badge ──────────────────────────────────────── */
    .rel-badge {
      font-size: 0.64rem;
      padding: 1px 6px;
      border-radius: 2px;
      letter-spacing: 0.04em;
      font-weight: 500;
      white-space: nowrap;
    }
  </style>

  <!-- Esc key → back -->
  <script is:inline>
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && !e.target.closest("input, textarea")) {
        history.back();
      }
    });
  </script>
</Layout>
