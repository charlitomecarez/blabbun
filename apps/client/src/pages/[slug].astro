---
import { PostHero } from "@blabbun/ui/components/cards";
import {
  BookmarkButton,
  MidScrollReaction,
  ReactionBar,
  ReadingDots,
  ReadingProgress,
} from "@blabbun/ui/components/post";
import { readTime, tagClass } from "@blabbun/utils";
import { getCollection, render } from "astro:content";
import { shuffle } from "lodash-es";

import CheckpointDividers from "@/components/post/CheckpointDividers.svelte";
import ClapShare from "@/components/post/ClapShare.svelte";
import Comments from "@/components/post/Comments.svelte";
import FloatingNewsletter from "@/components/post/FloatingNewsletter.svelte";
import WelcomeConfetti from "@/components/post/WelcomeConfetti.svelte";
import Layout from "@/layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id } }));
}

const { slug } = Astro.params;
const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const post = allPosts.find((p) => p.id === slug);

if (!post) return new Response(null, { status: 404 });

const { Content } = await render(post);

const postReadTime = readTime(post.body ?? "");
const tags = (post.data.tags ?? ["EDITORIAL"]).map((t) => t.toUpperCase());
const postUrl = `${Astro.site ?? "https://blabbun.com"}/${post.id}`;
const hasImage = !!post.data.image;

const postTags = new Set((post.data.tags ?? []).map((t) => t.toUpperCase()));

const otherPosts = allPosts.filter((p) => p.id !== post.id);

// Score by shared tags, shuffle within each tier so ties vary
const scored = shuffle(otherPosts)
  .map((p) => {
    const sharedTags = (p.data.tags ?? []).filter((t) =>
      postTags.has(t.toUpperCase())
    ).length;
    return { post: p, sharedTags };
  })
  .sort((a, b) => b.sharedTags - a.sharedTags);

const relatedSlice = scored.slice(0, 3).map((s) => s.post);

const relatedPosts = relatedSlice.map((p) => ({
  title: p.data.title,
  excerpt: p.data.description,
  tags: (p.data.tags ?? ["EDITORIAL"]).map((t) => t.toUpperCase()),
  href: `/${p.id}`,
  readTime: readTime(p.body ?? ""),
  date: p.data.pubDate.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }),
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  url: postUrl,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  keywords: post.data.tags?.join(", "),
  author: {
    "@type": "Person",
    name: "blabbun",
    url: `${Astro.site ?? "https://blabbun.com"}/about`,
  },
  publisher: {
    "@type": "Organization",
    name: "blabbun",
    alternateName: "Blab Bun",
    url: Astro.site ?? "https://blabbun.com",
  },
  ...(post.data.image ? { image: post.data.image } : {}),
};
---

<Layout
  title={post.data.title}
  description={post.data.description}
  ogImage={post.data.image}
  ogType="article"
>
  <ReadingProgress client:idle />
  <ReadingDots client:idle />
  {slug === "welcome-to-blab-bun" && <WelcomeConfetti client:load />}

  <main
    class="mx-auto min-h-[60vh] w-full max-w-[680px] flex-1 px-4 pt-10 pb-6 sm:px-8 sm:py-8"
  >
    <!-- Post header (matches PostDetailView) -->
    <PostHero
      title={post.data.title}
      tags={tags}
      readTime={postReadTime}
      pubDate={post.data.pubDate}
      backHref="/"
    />

    <!-- Optional image -->
    {
      hasImage && (
        <div style="margin-bottom:24px">
          <img
            src={post.data.image}
            alt={post.data.title}
            width="616"
            height="280"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="post-hero-img"
            style="width:100%;border-radius:6px;object-fit:cover;display:block"
          />
          {post.data.imageSource && (
            <p style="font-size:0.62rem;text-align:right;margin-top:4px;color:var(--muted2)">
              image:{" "}
              {post.data.imageSourceUrl ? (
                <a
                  href={post.data.imageSourceUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  style="color:var(--accent)"
                >
                  {post.data.imageSource}
                </a>
              ) : (
                post.data.imageSource
              )}
            </p>
          )}
        </div>
      )
    }

    <!-- Article body — matches design's content paragraphs -->
    <div style="padding-top:4px">
      <div
        class="prose prose-p:font-mono prose-p:text-[0.94rem] prose-p:leading-[1.9] prose-p:mb-5 prose-p:text-[var(--muted)] prose-p:text-wrap-pretty prose-headings:font-mono prose-headings:font-semibold prose-headings:text-[var(--text)] prose-h2:text-[1.1rem] prose-h2:mt-10 prose-h2:mb-4 prose-h3:text-[0.95rem] prose-h3:mt-7 prose-h3:mb-3 prose-a:text-[var(--accent)] prose-a:no-underline hover:prose-a:underline prose-strong:text-[var(--text)] prose-strong:font-semibold prose-ul:pl-6 prose-ol:pl-6 prose-li:text-[0.94rem] prose-li:text-[var(--muted)] prose-li:leading-[1.9] prose-li:my-1 prose-code:font-mono prose-code:text-[var(--text)] prose-code:bg-[var(--bg2)] prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-code:text-[0.82em] prose-pre:bg-[var(--bg2)] prose-pre:text-[var(--text)] prose-pre:rounded prose-pre:overflow-x-auto prose-pre:text-[0.82em] prose-blockquote:border-l-2 prose-blockquote:border-[var(--accent)] prose-blockquote:bg-[var(--bg2)] prose-blockquote:px-4 prose-blockquote:py-1 prose-blockquote:text-[var(--muted)] prose-blockquote:not-italic prose-hr:border-[var(--divider)] prose-hr:my-8 prose-img:rounded prose-img:w-full prose-img:my-8 prose-img:block prose-figure:my-8 prose-figcaption:text-center prose-figcaption:text-[0.7rem] prose-figcaption:text-[var(--muted2)] prose-figcaption:mt-[-20px] prose-figcaption:mb-2 post-content max-w-none"
      >
        <Content />
      </div>
      <CheckpointDividers client:idle />
      <MidScrollReaction client:load slug={post.id} />
    </div>

    <!-- End of blab marker -->
    <div
      style="text-align:center;margin:48px 0 8px;font-family:'Caveat',cursive;font-size:1.6rem;color:var(--accent);letter-spacing:0.4em"
    >
      ✶ · ✶
    </div>
    <div
      style="text-align:center;font-family:'Caveat',cursive;font-size:1.2rem;color:var(--muted);margin-bottom:8px"
    >
      end of blab.
    </div>

    <!-- Reactions -->
    <ReactionBar client:visible slug={post.id} />

    <!-- Actions: ClapButton + SharePanel + 🔖 (margin-left:auto) — exact PostDetailView layout -->
    <div
      style="display:flex;align-items:center;gap:14px;margin-top:28px;padding-top:24px;border-top:1px dashed var(--border);flex-wrap:wrap"
    >
      <ClapShare
        client:visible
        postSlug={post.id}
        postUrl={postUrl}
        postTitle={post.data.title}
      >
        <div style="margin-left: auto">
          <BookmarkButton client:visible slug={post.id} />
        </div>
      </ClapShare>
    </div>

    <!-- WHAT NOW card — "still here? read this next →" -->
    {
      relatedPosts.length > 0 && (
        <div class="what-now-card">
          <div class="tape" style="top:-9px;left:40%;transform:rotate(-3deg)" />
          <a
            href={relatedPosts[0].href}
            class="what-now-link"
            aria-label={relatedPosts[0].title}
          >
            <span />
          </a>
          <div style="font-family:'Caveat',cursive;font-size:1.2rem;color:var(--accent);margin-bottom:6px">
            still here? read this next →
          </div>
          <div style="font-family:'Fraunces',serif;font-style:italic;font-size:1.4rem;font-weight:500;line-height:1.25;color:var(--text);text-wrap:pretty">
            {relatedPosts[0].title}
          </div>
          <div style="font-size:0.74rem;color:var(--muted);margin-top:8px">
            {relatedPosts[0].date} · {relatedPosts[0].readTime}
          </div>
        </div>
      )
    }

    <!-- Comments -->
    <Comments client:visible postSlug={post.id} />

    <!-- Related posts -->
    {
      relatedPosts.length > 0 && (
        <div style="margin-top:48px;padding-top:32px;border-top:1px solid var(--divider)">
          <div style="font-size:0.72rem;color:var(--muted);letter-spacing:0.06em;margin-bottom:20px;text-transform:uppercase">
            more from blab bun
          </div>
          <div>
            {relatedPosts.map((p) => (
              <div class="rel-row">
                <a
                  href={p.href}
                  class="absolute inset-0 z-0"
                  aria-label={p.title}
                />

                <div style="display:flex;gap:8px;align-items:center;margin-bottom:5px">
                  <span style="font-size:0.65rem;color:var(--muted)">
                    {p.date}
                  </span>
                  {p.tags.map((t) => (
                    <span class={`rel-badge ${tagClass(t)}`}>{t}</span>
                  ))}
                </div>

                <div class="rel-title">{p.title}</div>
              </div>
            ))}
          </div>
        </div>
      )
    }
  </main>

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  <style>
    /* ─── Hero image ───────────────────────────────────────────── */
    .post-hero-img {
      max-height: 280px;
    }
    @media (max-width: 640px) {
      .post-hero-img {
        max-height: 200px;
        border-radius: 4px;
        width: calc(100% - 16px);
        margin-left: 8px;
        margin-right: 8px;
      }
    }

    /* ─── WHAT NOW card ───────────────────────────────────────── */
    .what-now-card {
      margin-top: 40px;
      background: var(--bg2);
      border: 1.5px solid var(--text);
      padding: 24px 26px;
      transform: rotate(-0.5deg);
      box-shadow: 4px 4px 0 var(--text);
      cursor: pointer;
      position: relative;
      transition: transform 0.15s;
    }
    .what-now-card:hover {
      transform: rotate(-0.5deg) translate(-2px, -2px);
    }
    .what-now-link {
      position: absolute;
      inset: 0;
      z-index: 0;
    }

    /* ─── Related posts hover ──────────────────────────────────── */
    .rel-row {
      padding: 14px 0;
      border-bottom: 1px solid var(--divider);
      cursor: pointer;
      position: relative;
    }
    .rel-title {
      font-size: 0.84rem;
      font-weight: 500;
      line-height: 1.45;
      color: var(--text);
      transition: color 0.15s;
      text-wrap: pretty;
    }
    .rel-row:hover .rel-title {
      color: var(--accent);
    }

    /* ─── Small tag badge ──────────────────────────────────────── */
    .rel-badge {
      font-size: 0.64rem;
      padding: 1px 6px;
      border-radius: 2px;
      letter-spacing: 0.04em;
      font-weight: 500;
      white-space: nowrap;
    }
  </style>

  <!-- Esc key → back -->
  <script is:inline>
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && !e.target.closest("input, textarea")) {
        history.back();
      }
    });
  </script>

  <FloatingNewsletter client:idle postSlug={post.id} />
</Layout>
