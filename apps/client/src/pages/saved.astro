---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="saved" description="Your bookmarked posts.">
  <main
    style="max-width:680px;margin:0 auto;padding:32px 32px;width:100%;flex:1;min-height:60vh"
  >
    <div style="animation:fadeIn 0.2s ease">
      <a
        href="/"
        style="background:none;border:none;color:var(--accent);font-size:0.76rem;cursor:pointer;font-family:inherit;padding:0;margin-bottom:28px;display:inline-block;text-decoration:none"
      >
        ← back
      </a>

      <h1
        style="font-size:1.05rem;font-weight:600;margin-bottom:6px;margin-top:20px"
      >
        saved
      </h1>
      <div
        id="saved-count"
        style="font-size:0.72rem;color:var(--muted);margin-bottom:24px"
      >
        0 posts bookmarked
      </div>

      <div
        id="saved-empty"
        style="padding:40px 0;font-size:0.8rem;color:var(--muted);border-top:1px solid var(--divider)"
      >
        nothing saved yet. hit the 🔖 on any post to save it for later.
      </div>

      <div id="saved-list" style="padding-left:20px;display:none"></div>
    </div>
  </main>
</Layout>

<script>
  const countEl = document.getElementById("saved-count")!;
  const emptyEl = document.getElementById("saved-empty")!;
  const listEl = document.getElementById("saved-list")!;

  const slugs = Object.keys(localStorage)
    .filter(
      (k) => k.startsWith("bb-bookmark-") && localStorage.getItem(k) === "1"
    )
    .map((k) => k.replace("bb-bookmark-", ""));

  countEl.textContent = `${slugs.length} post${slugs.length !== 1 ? "s" : ""} bookmarked`;

  if (slugs.length > 0) {
    emptyEl.style.display = "none";
    listEl.style.display = "block";

    slugs.forEach((slug) => {
      const item = document.createElement("div");
      item.style.cssText =
        "padding:14px 0;border-bottom:1px solid var(--divider);cursor:pointer;position:relative";
      item.innerHTML = `
        <a href="/${slug}"
          style="display:block;font-size:0.93rem;font-weight:500;line-height:1.5;color:var(--text);text-decoration:none;text-wrap:pretty;transition:color 0.15s"
          onmouseenter="this.style.color='var(--accent)'"
          onmouseleave="this.style.color='var(--text)'"
        >/${slug}</a>
        <button onclick="event.stopPropagation();localStorage.removeItem('bb-bookmark-${slug}');this.closest('div').remove();updateCount()"
          style="background:none;border:none;cursor:pointer;font-size:0.68rem;color:var(--muted2);padding:0;margin-top:4px;font-family:inherit"
        >remove</button>
      `;
      listEl.appendChild(item);
    });
  }

  function updateCount() {
    const remaining = Object.keys(localStorage).filter(
      (k) => k.startsWith("bb-bookmark-") && localStorage.getItem(k) === "1"
    ).length;
    countEl.textContent = `${remaining} post${remaining !== 1 ? "s" : ""} bookmarked`;
    if (remaining === 0) {
      emptyEl.style.display = "block";
      listEl.style.display = "none";
    }
    window.dispatchEvent(new Event("storage"));
  }
  (window as Window & { updateCount?: () => void }).updateCount = updateCount;
</script>
