---
import SavedFeed from "@/components/saved/SavedFeed.svelte";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Saved Posts"
  description="Your bookmarked posts on Blab Bun — read them later, whenever."
>
  <main
    class="mx-auto min-h-[60vh] w-full max-w-[680px] flex-1 px-4 py-6 sm:px-8 sm:py-8"
  >
    <div class="animate-[fadeIn_0.2s_ease]">
      <a
        href="/"
        class="mb-7 inline-block text-[0.76rem] text-[var(--accent)] no-underline"
      >
        ← back
      </a>

      <h1 class="mt-5 mb-6 text-[1.05rem] font-semibold">saved</h1>

      <SavedFeed client:load />
    </div>
  </main>
</Layout>
