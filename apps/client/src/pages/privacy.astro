---
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="privacy"
  description="Privacy policy for Blab Bun (blabbun) — what data is collected and how it's used."
>
  <main
    class="mx-auto min-h-[60vh] w-full max-w-[680px] flex-1 px-4 py-6 sm:px-8 sm:py-10"
  >
    <div class="reveal">
      <!-- back -->
      <a
        href="/?utm_source=privacy&utm_medium=internal&utm_campaign=back_nav"
        style="color:var(--accent);font-family:'Caveat',cursive;font-size:1.1rem;
               text-decoration:none;padding:0;display:inline-block;margin-bottom:24px"
      >
        ← back to the blabs
      </a>

      <!-- title row -->
      <div
        style="display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin-bottom:8px"
      >
        <h1
          style="font-family:'Fraunces',serif;font-size:2.4rem;font-weight:600;letter-spacing:-0.02em"
        >
          privacy
        </h1>
        <span
          style="font-family:'Caveat',cursive;font-size:1.2rem;color:var(--accent);
                 transform:rotate(-3deg);display:inline-block"
        >
          (the honest version)
        </span>
      </div>

      <!-- scribble underline -->
      <svg
        width="160"
        height="14"
        viewBox="0 0 160 14"
        style="margin-bottom:28px;display:block"
        aria-hidden="true"
      >
        <path
          d="M2 8 Q 24 2, 48 8 T 96 8 T 158 7"
          stroke="var(--accent)"
          stroke-width="2"
          fill="none"
          stroke-linecap="round"></path>
      </svg>

      <!-- content -->
      <div
        style="font-size:0.9rem;color:var(--muted);line-height:1.95;max-width:580px;
               display:flex;flex-direction:column;gap:14px"
      >
        <p>
          this site uses <strong style="font-weight:500;color:var(--text)"
            >Google Analytics (GA4)</strong
          > to understand basic traffic patterns — page views, referrers, session
          counts, and which posts people actually read. GA sets cookies and sends
          that data to Google. you can opt out via <a
            href="https://tools.google.com/dlpage/gaoptout"
            target="_blank"
            rel="noopener noreferrer"
            style="color:var(--accent);text-decoration:none"
            >Google's opt-out tool</a
          >.
        </p>

        <p>
          if you subscribe to the newsletter, i store your email address in a
          database (supabase). that's it. i'm not selling it, renting it, or
          doing anything weird with it. you can unsubscribe any time via the
          link in any email i send.
        </p>

        <p>
          comments are saved server-side and are anonymous — no account, no name
          required. claps work the same way: your IP address is hashed (sha-256,
          one-way) to prevent duplicates, but the raw address is never stored.
        </p>

        <p>
          page view counts are tracked per post. no personal data is attached to
          a view — it's just a counter.
        </p>
      </div>
    </div>
  </main>

  <style>
    @media (max-width: 640px) {
      h1 {
        font-size: 1.75rem !important;
      }
    }
  </style>
</Layout>
