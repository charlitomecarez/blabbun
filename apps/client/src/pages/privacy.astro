---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="privacy" description="Privacy policy for Blab Bun.">
  <main class="mx-auto min-h-[60vh] w-full max-w-[680px] flex-1 px-8">
    <div class="animate-[fadeIn_0.2s_ease]">
      <!-- back -->
      <a
        href="/?utm_source=privacy&utm_medium=internal&utm_campaign=back_nav"
        class="mb-7 inline-block text-[0.76rem] text-[var(--accent)] no-underline"
      >
        ← back
      </a>

      <!-- title -->
      <h1 class="mt-5 mb-6 text-[1.05rem] font-semibold">privacy</h1>

      <!-- content -->
      <div
        class="”max-w-[540px]"
        space-y-3.5
        text-[0.82rem]
        leading-[1.9]
        text-[var(--muted)]”
      >
        <p>
          this site uses <strong class="”font-medium" text-[var(--text)]”
            >Google Analytics (GA4)</strong
          > to understand basic traffic patterns — page views, referrers, session
          counts, and which posts people actually read. GA sets cookies and sends
          that data to Google. you can opt out via
          <a
            href="”https://tools.google.com/dlpage/gaoptout”"
            target="”_blank”"
            rel="”noopener"
            noreferrer”
            class="”text-[var(--accent)]"
            no-underline”>Google's opt-out tool</a
          >.
        </p>

        <p>
          if you subscribe to the newsletter, i store your email address in a
          database (supabase). that&apos;s it. i&apos;m not selling it, renting
          it, or doing anything weird with it. you can unsubscribe any time via
          the link in any email i send.
        </p>

        <p>
          comments are saved server-side and are anonymous — no account, no name
          required. claps work the same way: your IP address is hashed (sha-256,
          one-way) to prevent duplicates, but the raw address is never stored.
        </p>

        <p>
          page view counts are tracked per post. no personal data is attached to
          a view — it&apos;s just a counter.
        </p>
      </div>
    </div>
  </main>
</Layout>
