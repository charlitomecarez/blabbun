---
export const prerender = false;

import { readTime } from "@blabbun/utils";
import { getCollection } from "astro:content";

import HomeFeed from "@/components/home/HomeFeed.svelte";
import NewsletterBar from "@/components/home/NewsletterBar.svelte";
import ScribbleDivider from "@/components/home/ScribbleDivider.svelte";
import Ticker from "@/components/home/Ticker.svelte";
import Layout from "@/layouts/Layout.astro";
import { getAppEnv, getRuntimeEnv, getSupabaseClient } from "@/lib/api";
import { fetchPostStats } from "@/lib/stats";

const runtimeEnv = getRuntimeEnv(Astro.locals);
const appEnv = getAppEnv(runtimeEnv);
const supabase = getSupabaseClient(
  runtimeEnv.SUPABASE_URL ?? import.meta.env.SUPABASE_URL,
  runtimeEnv.SUPABASE_SERVICE_ROLE_KEY ??
    import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const stats = await fetchPostStats(
  posts.slice(0, 5).map((p) => p.id),
  supabase,
  appEnv
);

const feedItems = posts.map((post, i) => ({
  postNumber: posts.length - i,
  date: post.data.pubDate.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }),
  title: post.data.title,
  excerpt: post.data.description,
  tags: (post.data.tags ?? ["EDITORIAL"]).map((t) => t.toUpperCase()),
  readTime: readTime(post.body ?? ""),
  imageUrl: post.data.image,
  href: `/${post.id}`,
  claps: stats[post.id]?.claps,
  commentCount: stats[post.id]?.commentCount,
  views: stats[post.id]?.views,
}));

const allTags = [
  ...new Set(
    posts.flatMap((p) => p.data.tags ?? []).map((t) => t.toUpperCase())
  ),
];
---

<Layout
  title="Unfiltered Takes & Half-Baked Thoughts"
  description="Blab Bun (blabbun) — a blog of unfiltered takes, half-finished thoughts, and things probably better left unsaid. New posts drop whenever the bun feels like it."
>
  <main class="mx-auto min-h-[60vh] w-full max-w-[680px] flex-1 px-8">
    <!-- Hero section -->
    <section
      style="padding: 24px 0 0; position: relative;"
      aria-label="Site introduction"
    >
      <div
        style="display:flex; align-items:flex-start; gap:24px; margin-bottom:8px; flex-wrap:wrap;"
      >
        <div style="flex:1; min-width:240px; padding-top:4px;">
          <h1
            class="serif"
            style="font-size:2.1rem; font-weight:600; line-height:1.05; margin-bottom:8px; text-wrap:balance; letter-spacing:-0.02em;"
          >
            unfiltered takes &amp;<br />
            <span class="scribble-underline" style="font-style:italic"
              >half-baked thoughts</span
            >
          </h1>
          <p
            style="font-size:0.78rem; color:var(--muted); line-height:1.7; margin-top:14px;"
          >
            probably should've kept to myself. but here we are.
          </p>
          <!-- Social share links -->
          <div
            style="display:flex;gap:14px;align-items:center;margin-top:18px;flex-wrap:wrap;"
          >
            <a
              href="https://twitter.com/intent/tweet?url=https%3A%2F%2Fblabbun.com%3Futm_source%3Dtwitter%26utm_medium%3Dsocial%26utm_campaign%3Dhomepage_share&text=check+out+blab+bun+%E2%80%94+unfiltered+takes+%26+half-baked+thoughts"
              target="_blank"
              rel="noopener noreferrer"
              style="font-size:0.72rem;color:var(--muted);text-decoration:none;display:inline-flex;align-items:center;gap:5px;transition:color 0.15s;"
              aria-label="Share Blab Bun on X (Twitter)"
            >
              <svg
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                ></path>
              </svg>
              share on x
            </a>
            <a
              href="/rss.xml"
              style="font-size:0.72rem;color:var(--muted);text-decoration:none;display:inline-flex;align-items:center;gap:5px;transition:color 0.15s;"
              aria-label="Subscribe via RSS"
            >
              <svg
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
                <circle cx="5" cy="19" r="1" fill="currentColor"></circle>
              </svg>
              rss
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Static content for search engine crawlers -->
    <div
      style="position:fixed;top:-9999px;left:-9999px;width:1px;height:1px;overflow:hidden;"
      aria-hidden="true"
    >
      <p>
        Blab Bun is a personal blog of unfiltered opinions, half-baked thoughts,
        and writing that probably should have stayed in the drafts. Topics
        include life, culture, anime, traffic, and whatever else the bun is
        thinking about. New posts published regularly — no editorial calendar,
        no agenda, just honest writing.
      </p>
    </div>

    <Ticker client:idle />

    <HomeFeed feedItems={feedItems} allTags={allTags} client:idle />

    <ScribbleDivider client:idle />

    <NewsletterBar client:visible />
  </main>
</Layout>
