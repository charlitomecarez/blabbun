---
export const prerender = false;

import { readTime } from "@blabbun/utils";
import { getCollection } from "astro:content";

import HomeFeed from "@/components/home/HomeFeed.svelte";
import NewsletterBar from "@/components/home/NewsletterBar.svelte";
import ScribbleDivider from "@/components/home/ScribbleDivider.svelte";
import Ticker from "@/components/home/Ticker.svelte";
import Layout from "@/layouts/Layout.astro";
import { getRuntimeEnv, getSupabaseClient } from "@/lib/api";
import { fetchPostStats } from "@/lib/stats";

const runtimeEnv = getRuntimeEnv(Astro.locals);
const supabase = getSupabaseClient(
  runtimeEnv.SUPABASE_URL ?? import.meta.env.SUPABASE_URL,
  runtimeEnv.SUPABASE_SERVICE_ROLE_KEY ??
    import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const stats = await fetchPostStats(
  posts.slice(0, 10).map((p) => p.id),
  supabase
);

const feedItems = posts.map((post) => ({
  date: post.data.pubDate.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }),
  title: post.data.title,
  excerpt: post.data.description,
  tag: (post.data.tags?.[0] ?? "EDITORIAL").toUpperCase(),
  readTime: readTime(post.body ?? ""),
  imageUrl: post.data.image,
  href: `/${post.id}`,
  claps: stats[post.id]?.claps,
  commentCount: stats[post.id]?.commentCount,
}));

const allTags = [
  ...new Set(
    posts.flatMap((p) => p.data.tags ?? []).map((t) => t.toUpperCase())
  ),
];
---

<Layout>
  <main class="mx-auto min-h-[60vh] w-full max-w-[680px] flex-1 px-8">
    <!-- Hero section -->
    <section
      style="padding: 24px 0 0; position: relative;"
      aria-label="Site introduction"
    >
      <div
        style="display:flex; align-items:flex-start; gap:24px; margin-bottom:8px; flex-wrap:wrap;"
      >
        <img
          src="/blabbun-logo.webp"
          alt="blab bun"
          width="64"
          height="64"
          fetchpriority="high"
          style="width:64px;height:64px;object-fit:contain;flex-shrink:0;"
        />
        <div style="flex:1; min-width:240px; padding-top:4px;">
          <h1
            class="serif"
            style="font-size:2.1rem; font-weight:600; line-height:1.05; margin-bottom:8px; text-wrap:balance; letter-spacing:-0.02em;"
          >
            unfiltered takes &amp;<br />
            <span class="scribble-underline" style="font-style:italic"
              >half-baked thoughts</span
            >
          </h1>
          <p
            style="font-size:0.78rem; color:var(--muted); line-height:1.7; margin-top:14px;"
          >
            probably should've kept to myself. but here we are.
          </p>
        </div>
      </div>
    </section>

    <Ticker client:idle />

    <!-- "latest blab" label + fresh badge wrapper -->
    <div style="position:relative; margin-bottom:8px; margin-top:8px;">
      <span
        class="handwritten"
        style="position:absolute; top:-14px; right:12px; background:var(--accent2); color:#fff; font-size:1.1rem; padding:4px 14px; border-radius:14px; transform:rotate(6deg); animation:wiggle 3s ease-in-out infinite; box-shadow:2px 2px 0 var(--text); z-index:5;"
        aria-hidden="true"
      >
        fresh out the oven!
      </span>
      <div
        class="handwritten"
        style="font-size:1.4rem; color:var(--accent); margin-bottom:4px; transform:rotate(-1deg); display:inline-block;"
      >
        latest blab ↓
      </div>
    </div>

    <HomeFeed feedItems={feedItems} allTags={allTags} client:idle />

    <ScribbleDivider client:idle />

    <NewsletterBar client:visible />
  </main>
</Layout>
