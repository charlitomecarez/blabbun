---
export const prerender = false;

import { readTime } from "@blabbun/utils";
import { getCollection } from "astro:content";

import HomeFeed from "@/components/home/HomeFeed.svelte";
import NewsletterBar from "@/components/home/NewsletterBar.svelte";
import Layout from "@/layouts/Layout.astro";
import { getRuntimeEnv, getSupabaseClient } from "@/lib/api";
import { fetchPostStats } from "@/lib/stats";

const runtimeEnv = getRuntimeEnv(Astro.locals);
const supabase = getSupabaseClient(
  runtimeEnv.SUPABASE_URL ?? import.meta.env.SUPABASE_URL,
  runtimeEnv.SUPABASE_SERVICE_ROLE_KEY ??
    import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const stats = await fetchPostStats(
  posts.slice(0, 10).map((p) => p.id),
  supabase
);

const feedItems = posts.map((post) => ({
  date: post.data.pubDate.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }),
  title: post.data.title,
  excerpt: post.data.description,
  tag: (post.data.tags?.[0] ?? "EDITORIAL").toUpperCase(),
  readTime: readTime(post.body ?? ""),
  imageUrl: post.data.image,
  href: `/${post.id}`,
  claps: stats[post.id]?.claps,
  commentCount: stats[post.id]?.commentCount,
}));

const allTags = [
  ...new Set(
    posts.flatMap((p) => p.data.tags ?? []).map((t) => t.toUpperCase())
  ),
];
---

<Layout>
  <main class="mx-auto min-h-[60vh] w-full max-w-[680px] flex-1 px-8">
    <!-- subtitle -->
    <div
      class="mb-6 animate-[fadeIn_0.2s_ease] border-b border-[var(--divider)] pb-5"
    >
      <div class="text-[0.72rem] leading-[1.7] text-[var(--muted)]">
        unfiltered takes &amp; half-baked thoughts — probably should've kept to
        myself
      </div>
    </div>

    <HomeFeed feedItems={feedItems} allTags={allTags} client:idle />

    <!-- newsletter -->
    <NewsletterBar client:visible />
  </main>
</Layout>
