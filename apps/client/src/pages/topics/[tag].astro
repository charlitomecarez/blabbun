---
import { tagToLabel } from "@blabbun/utils";
import { getCollection } from "astro:content";

import ArchiveList from "@/components/archive/ArchiveList.svelte";
import Layout from "@/layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const tags = [
    ...new Set(
      posts.flatMap((p) => p.data.tags ?? []).map((t) => t.toUpperCase())
    ),
  ];
  return tags.map((tag) => ({ params: { tag } }));
}

const { tag: rawTag } = Astro.params;
const tag = rawTag || "";

const allPosts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const tagPosts = allPosts.filter((p) =>
  p.data.tags?.map((t) => t.toUpperCase()).includes(tag || "")
);

const postItems = tagPosts.map((post) => ({
  title: post.data.title,
  description: post.data.description,
  pubDate: post.data.pubDate.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }),
  pubDateRaw: post.data.pubDate.toISOString(),
  monthGroup: post.data.pubDate.toLocaleDateString("en-US", {
    month: "long",
    year: "numeric",
  }),
  tags: (post.data.tags ?? ["EDITORIAL"]).map((t) => t.toUpperCase()),
  href: `/${post.id}`,
  imageUrl: post.data.image,
}));

const label = tagToLabel(tag);
---

<Layout
  title={label}
  description={`${postItems.length} post${postItems.length === 1 ? "" : "s"} about ${label} on blabbun — unfiltered takes and honest writing.`}
>
  <main
    class="mx-auto min-h-[60vh] w-full max-w-[680px] flex-1 px-4 py-6 sm:px-8 sm:py-8"
  >
    <div style="margin-bottom:22px">
      <a
        href="/topics"
        style="
          display:inline-flex;align-items:center;gap:5px;
          font-size:0.68rem;font-weight:600;color:var(--muted2);
          text-decoration:none;transition:color 0.15s;margin-bottom:14px;
        "
        onmouseenter="this.style.color='var(--accent)'"
        onmouseleave="this.style.color='var(--muted2)'"
      >
        <svg
          width="11"
          height="11"
          viewBox="0 0 14 14"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M13 7H1M6 2L1 7l5 5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        topics
      </a>

      <div style="margin-bottom:8px">
        <span
          style="
            font-size:0.65rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;
            background:var(--accent);color:#fff;
            border-radius:3px;padding:3px 8px;
          "
        >
          {tag}
        </span>
      </div>

      <h1 style="font-size:1.05rem;font-weight:600;margin-bottom:4px">
        {label}
      </h1>
      <p style="font-size:0.72rem;color:var(--muted2)">
        {postItems.length}
        {postItems.length === 1 ? "post" : "posts"}
      </p>
    </div>

    <ArchiveList posts={postItems} tags={[]} lockedTag={tag} client:load />
  </main>
</Layout>
