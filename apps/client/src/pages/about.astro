---
import { getCollection } from "astro:content";

import Layout from "@/layouts/Layout.astro";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const totalWords = posts.reduce(
  (a, p) => a + (p.body?.trim().split(/\s+/).length ?? 0),
  0
);
---

<Layout
  title="About"
  description="The person behind blabbun — a blog of unfiltered takes, half-finished thoughts, and things probably better left unsaid."
>
  <main class="mx-auto min-h-[60vh] w-full max-w-[680px] flex-1 px-8 py-10">
    <div class="animate-[fadeIn_0.2s_ease]">
      <!-- back -->
      <a
        href="/"
        class="mb-7 inline-block text-[0.76rem] text-[var(--accent)] no-underline"
      >
        ← back
      </a>

      <!-- header -->
      <div class="mt-5 mb-9 flex flex-wrap items-start gap-5">
        <img
          src="/blabbun-logo.webp"
          alt="blab bun"
          width="72"
          height="72"
          class="h-[72px] w-[72px] shrink-0 object-contain"
        />

        <div>
          <h1 class="mb-1.5 text-[1.1rem] font-semibold text-[var(--text)]">
            hey, i'm the bun.
          </h1>

          <div class="text-[0.72rem] leading-relaxed text-[var(--muted)]">
            {posts.length} posts · ~{totalWords.toLocaleString()} words written ·
            still going
          </div>
        </div>
      </div>

      <!-- body -->
      <div
        class="max-w-[560px] space-y-5 text-[0.88rem] leading-[1.9] text-[var(--muted)]"
      >
        <p>
          this is a blog where i say things that should&apos;ve stayed in my
          head but didn&apos;t. half-baked thoughts, overconfident takes, and
          rants that started as one thing and somehow derailed into something
          else entirely.
        </p>

        <p>
          this is basically me thinking out loud, just in public, like a normal
          and well-adjusted person 👍 (do not fact check that).
        </p>

        <p>
          it&apos;s called blab bun. i blab. i am a bun. at some point this made
          perfect sense and now it&apos;s too late to turn back so here we are.
        </p>

        <p>
          if something i wrote made you think, laugh, get annoyed, or open a new
          tab to prove me wrong — good. leave a comment. argue with me.
          spiritually fight me. that&apos;s the whole point.
        </p>
      </div>

      <!-- status -->
      <div
        class="mt-10 flex flex-wrap gap-4 border-t border-[var(--divider)] pt-6"
      >
        {
          [
            ["currently reading", "whatever's been open in a tab too long"],
            ["currently thinking about", "why everything has a vibe now"],
            ["last updated", "Apr 2026"],
          ].map(([k, v]) => (
            <div class="min-w-[160px]">
              <div class="mb-1 text-[0.65rem] tracking-[0.06em] text-[var(--muted)] uppercase">
                {k}
              </div>
              <div class="text-[0.78rem] leading-[1.5] text-[var(--muted)]">
                {v}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </main>
</Layout>
