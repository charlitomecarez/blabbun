---
import { getCollection } from "astro:content";

import Layout from "@/layouts/Layout.astro";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const totalWords = posts.reduce(
  (a, p) => a + (p.body?.trim().split(/\s+/).length ?? 0),
  0
);
---

<Layout
  title="About"
  description="hey, i'm the bun. unfiltered thoughts since whenever."
>
  <main
    style="max-width:680px;margin:0 auto;padding:32px 32px;width:100%;flex:1;min-height:60vh"
  >
    <div style="animation:fadeIn 0.2s ease">
      <a
        href="/"
        style="background:none;border:none;color:var(--accent);font-size:0.76rem;cursor:pointer;font-family:inherit;padding:0;margin-bottom:28px;display:inline-block;text-decoration:none"
      >
        ← back
      </a>

      <!-- Avatar + title -->
      <div
        style="display:flex;align-items:flex-start;gap:20px;margin-bottom:36px;flex-wrap:wrap;margin-top:20px"
      >
        <img
          src="/blabbun-logo.webp"
          alt="blab bun"
          width="72"
          height="72"
          style="width:72px;height:72px;object-fit:contain;flex-shrink:0"
        />
        <div>
          <h1
            style="font-size:1.1rem;font-weight:600;margin-bottom:6px;color:var(--text)"
          >
            hey, i'm the bun.
          </h1>
          <div style="font-size:0.72rem;color:var(--muted);line-height:1.6">
            {posts.length} posts · ~{totalWords.toLocaleString()} words written ·
            still going
          </div>
        </div>
      </div>

      <!-- Body — same text style as blog prose: 0.88rem / var(--muted) / lineHeight 1.9 -->
      <div style="max-width:560px">
        <p
          style="font-size:0.88rem;line-height:1.9;color:var(--muted);margin-bottom:20px;text-wrap:pretty"
        >
          this is a blog where i write things i probably shouldn't. unfinished
          thoughts, strong opinions i haven't fully stress-tested, rants that
          started as something else and ended up here.
        </p>
        <p
          style="font-size:0.88rem;line-height:1.9;color:var(--muted);margin-bottom:20px;text-wrap:pretty"
        >
          i'm not trying to build an audience. i'm not trying to go viral. i'm
          trying to think out loud somewhere that isn't a group chat or a notes
          app that no one will ever see.
        </p>
        <p
          style="font-size:0.88rem;line-height:1.9;color:var(--muted);margin-bottom:20px;text-wrap:pretty"
        >
          the name is blab bun. i blab. i am a bun. it made sense at some point
          and i've committed to it.
        </p>
        <p
          style="font-size:0.88rem;line-height:1.9;color:var(--muted);margin-bottom:32px;text-wrap:pretty"
        >
          if something i wrote made you think, or made you annoyed, or made you
          want to argue — leave a comment. that's the whole point.
        </p>

        <!-- Status grid -->
        <div
          style="border-top:1px solid var(--divider);padding-top:24px;display:flex;gap:16px;flex-wrap:wrap"
        >
          {
            [
              ["currently reading", "whatever's been open in a tab too long"],
              ["currently thinking about", "why everything has a vibe now"],
              ["last updated", "Apr 2026"],
            ].map(([k, v]) => (
              <div style="min-width:160px">
                <div style="font-size:0.65rem;color:var(--muted);letter-spacing:0.06em;text-transform:uppercase;margin-bottom:4px">
                  {k}
                </div>
                <div style="font-size:0.78rem;color:var(--muted);line-height:1.5">
                  {v}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </main>
</Layout>
