---
import { getCollection } from "astro:content";

import Layout from "@/layouts/Layout.astro";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const totalWords = posts.reduce(
  (a, p) => a + (p.body?.trim().split(/\s+/).length ?? 0),
  0
);
---

<Layout
  title="About"
  description="The person behind blabbun — a blog of unfiltered takes, half-finished thoughts, and things probably better left unsaid."
>
  <main
    class="mx-auto min-h-[60vh] w-full max-w-[680px] flex-1 px-4 py-6 sm:px-8 sm:py-10"
  >
    <div style="animation:fadeIn 0.2s ease">
      <!-- back -->
      <a
        href="/"
        style="color:var(--accent);font-family:'Caveat',cursive;font-size:1.1rem;
               text-decoration:none;padding:0;display:inline-block;margin-bottom:24px"
      >
        ← back to the blabs
      </a>

      <!-- polaroid + name row -->
      <div
        style="display:flex;align-items:flex-start;gap:28px;margin-bottom:42px;flex-wrap:wrap"
      >
        <!-- polaroid card -->
        <div
          style="position:relative;background:var(--bg2);padding:14px 14px 38px;
                    box-shadow:4px 5px 0 var(--text);transform:rotate(-3deg);flex-shrink:0;
                    border:1px solid var(--border)"
        >
          <div class="tape" style="top:-10px;left:34px;transform:rotate(-6deg)">
          </div>
          <div
            style="width:120px;height:120px;background:linear-gradient(135deg,var(--accent-soft),var(--accent));
                      display:flex;align-items:center;justify-content:center;overflow:hidden"
          >
            <img
              src="/blabbun-logo.webp"
              alt="blab bun"
              width="88"
              height="88"
              style="width:88px;height:88px;object-fit:contain;transform:scale(1.3)"
            />
          </div>
          <div
            style="position:absolute;bottom:10px;left:0;right:0;text-align:center;
                      font-family:'Caveat',cursive;font-size:1.05rem;color:var(--text)"
          >
            it me, the bun ✶
          </div>
        </div>

        <!-- name + stats -->
        <div style="flex:1;min-width:200px;padding-top:12px">
          <h1
            style="font-family:'Fraunces',serif;font-size:2.2rem;font-weight:600;
                     line-height:1.05;margin-bottom:10px;letter-spacing:-0.02em;text-wrap:balance"
          >
            hey, i'm <span class="scribble-underline" style="font-style:italic"
              >the bun.</span
            >
          </h1>
          <div
            style="font-family:'Caveat',cursive;font-size:1.15rem;color:var(--muted);line-height:1.5"
          >
            {posts.length} posts · ~{totalWords.toLocaleString()} words written ·
            still going
          </div>
        </div>
      </div>

      <!-- body copy -->
      <div
        style="font-size:0.92rem;color:var(--text);line-height:1.95;max-width:580px"
      >
        <p style="margin-bottom:20px">
          <span
            style="font-family:'Fraunces',serif;font-size:2.6rem;float:left;line-height:0.9;
                       margin-right:8px;margin-top:4px;color:var(--accent);font-weight:600"
            >t</span
          >his is a blog where i write things i probably shouldn't. unfinished
          thoughts, strong opinions i haven't fully stress-tested, rants that
          started as something else and ended up here.
        </p>
        <p style="margin-bottom:20px">
          i'm not trying to build an audience. i'm not trying to go viral. i'm
          trying to think out loud somewhere that isn't a group chat or a notes
          app that no one will ever see.
        </p>
        <blockquote
          style="font-family:'Fraunces',serif;font-size:1.45rem;line-height:1.35;
                           font-style:italic;color:var(--accent);padding:8px 0 8px 24px;
                           margin:28px 0;border-left:4px solid var(--accent);text-wrap:pretty"
        >
          the name is blab bun. i blab. i am a bun.
        </blockquote>
        <p style="margin-bottom:32px">
          it made sense at some point and i've committed to it. if something i
          wrote made you think, or made you annoyed, or made you want to argue —
          leave a comment. that's the whole point.
        </p>
      </div>

      <!-- scribble divider -->
      <div style="display:flex;align-items:center;gap:14px;margin:32px 0 20px">
        <svg width="80" height="12" viewBox="0 0 80 12" aria-hidden="true">
          <path
            d="M2 6 Q 12 2, 22 6 T 42 6 T 62 6 T 78 6"
            stroke="var(--accent)"
            stroke-width="1.5"
            fill="none"
            stroke-linecap="round"></path>
        </svg>
        <span
          style="font-family:'Caveat',cursive;font-size:1rem;color:var(--muted);white-space:nowrap"
        >
          ↓ a few facts about me ↓
        </span>
        <svg
          width="80"
          height="12"
          viewBox="0 0 80 12"
          style="flex:1"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path
            d="M2 6 Q 12 2, 22 6 T 42 6 T 62 6 T 78 6"
            stroke="var(--accent)"
            stroke-width="1.5"
            fill="none"
            stroke-linecap="round"></path>
        </svg>
      </div>

      <!-- 4 individual sticky-note status cards -->
      <div style="display:flex;gap:18px;flex-wrap:wrap;margin-top:24px">
        {
          [
            [
              "currently reading",
              "whatever's been open in a tab too long",
              -1.5,
            ],
            ["currently thinking about", "why everything has a vibe now", 1.2],
            ["last updated", "Apr 2026", -0.8],
            ["favorite snack", "also bread (no comment)", 1.8],
          ].map(([k, v, r]) => (
            <div
              style={`min-width:200px;flex:1 1 200px;background:var(--bg2);
                       border:1.5px solid var(--text);padding:14px 16px;
                       transform:rotate(${r}deg);box-shadow:3px 3px 0 var(--text);position:relative`}
            >
              <div
                class="tape"
                style="top:-9px;left:20px;width:40px;height:14px;transform:rotate(-5deg);opacity:0.6"
              />
              <div style="font-family:'Caveat',cursive;font-size:0.95rem;color:var(--accent);margin-bottom:4px">
                {k} →
              </div>
              <div style="font-size:0.84rem;color:var(--text);line-height:1.5">
                {v}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </main>

  <style>
    @media (max-width: 640px) {
      h1 {
        font-size: 1.6rem !important;
      }
    }
  </style>
</Layout>
