---
export const prerender = false;

import { getCollection } from "astro:content";

import ArchiveList from "@/components/archive/ArchiveList.svelte";
import Layout from "@/layouts/Layout.astro";
import { getRuntimeEnv, getSupabaseClient } from "@/lib/api";
import { fetchPostStats } from "@/lib/stats";

const runtimeEnv = getRuntimeEnv(Astro.locals);
const supabase = getSupabaseClient(
  runtimeEnv.SUPABASE_URL ?? import.meta.env.SUPABASE_URL,
  runtimeEnv.SUPABASE_SERVICE_ROLE_KEY ??
    import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);

const allPosts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const stats = await fetchPostStats(
  allPosts.map((p) => p.id),
  supabase
);

const postItems = allPosts.map((post) => ({
  title: post.data.title,
  description: post.data.description,
  pubDate: post.data.pubDate.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }),
  pubDateRaw: post.data.pubDate.toISOString(),
  monthGroup: post.data.pubDate.toLocaleDateString("en-US", {
    month: "long",
    year: "numeric",
  }),
  tag: (post.data.tags?.[0] ?? "EDITORIAL").toUpperCase(),
  href: `/${post.id}`,
  imageUrl: post.data.image,
  claps: stats[post.id]?.claps,
  commentCount: stats[post.id]?.commentCount,
}));

const allTags = [
  ...new Set(
    allPosts.flatMap((p) => p.data.tags ?? []).map((t) => t.toUpperCase())
  ),
].sort();
---

<Layout
  title="Archive"
  description={`All ${allPosts.length} posts from Blab Bun.`}
>
  <main
    style="max-width:680px;margin:0 auto;padding:32px 32px;width:100%;flex:1;min-height:60vh"
  >
    <h1
      style="font-size:1.05rem;font-weight:600;margin-bottom:22px;animation:fadeIn 0.2s ease"
    >
      all posts
    </h1>

    <ArchiveList posts={postItems} tags={allTags} client:load />
  </main>
</Layout>
