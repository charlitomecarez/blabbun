---
export const prerender = false;

import { getCollection } from "astro:content";

import ArchiveList from "@/components/archive/ArchiveList.svelte";
import Layout from "@/layouts/Layout.astro";
import { getRuntimeEnv, getSupabaseClient } from "@/lib/api";
import { fetchPostStats } from "@/lib/stats";

const runtimeEnv = getRuntimeEnv(Astro.locals);
const supabase = getSupabaseClient(
  runtimeEnv.SUPABASE_URL ?? import.meta.env.SUPABASE_URL,
  runtimeEnv.SUPABASE_SERVICE_ROLE_KEY ??
    import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);

const allPosts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const stats = await fetchPostStats(
  allPosts.map((p) => p.id),
  supabase
);

const postItems = allPosts.map((post) => ({
  title: post.data.title,
  description: post.data.description,
  pubDate: post.data.pubDate.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }),
  pubDateRaw: post.data.pubDate.toISOString(),
  monthGroup: post.data.pubDate.toLocaleDateString("en-US", {
    month: "long",
    year: "numeric",
  }),
  tags: (post.data.tags ?? ["EDITORIAL"]).map((t) => t.toUpperCase()),
  href: `/${post.id}`,
  imageUrl: post.data.image,
  claps: stats[post.id]?.claps,
  commentCount: stats[post.id]?.commentCount,
}));

const allTags = [
  ...new Set(
    allPosts.flatMap((p) => p.data.tags ?? []).map((t) => t.toUpperCase())
  ),
].sort();
---

<Layout
  title="All Posts"
  description={`Browse all ${allPosts.length} posts on blabbun — unfiltered thoughts, essays, and half-baked ideas.`}
>
  <main
    class="mx-auto min-h-[60vh] w-full max-w-[680px] flex-1 px-4 py-6 sm:px-8 sm:py-10"
  >
    <div style="animation:fadeIn 0.2s ease">
      <!-- back -->
      <a
        href="/"
        style="color:var(--accent);font-family:'Caveat',cursive;font-size:1.1rem;
               text-decoration:none;padding:0;display:inline-block;margin-bottom:24px"
      >
        ← back to the blabs
      </a>

      <!-- title row -->
      <div
        style="display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin-bottom:8px"
      >
        <h1
          style="font-family:'Fraunces',serif;font-size:2.4rem;font-weight:600;letter-spacing:-0.02em"
        >
          all posts
        </h1>
        <span
          style="font-family:'Caveat',cursive;font-size:1.2rem;color:var(--accent);
                     transform:rotate(-3deg);display:inline-block"
        >
          {allPosts.length} blabs &amp; counting
        </span>
      </div>

      <!-- scribble underline -->
      <svg
        width="180"
        height="14"
        viewBox="0 0 180 14"
        style="margin-bottom:28px;display:block"
      >
        <path
          d="M2 8 Q 30 2, 60 8 T 120 8 T 178 7"
          stroke="var(--accent)"
          stroke-width="2"
          fill="none"
          stroke-linecap="round"></path>
      </svg>

      <ArchiveList posts={postItems} tags={allTags} client:load />
    </div>
  </main>

  <style>
    @media (max-width: 640px) {
      h1 {
        font-size: 1.75rem !important;
      }
    }
  </style>
</Layout>
