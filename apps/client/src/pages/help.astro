---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="help" description="Help for Blab Bun.">
  <main
    style="max-width:680px;margin:0 auto;padding:32px 32px;width:100%;flex:1;min-height:60vh"
  >
    <div style="animation:fadeIn 0.2s ease">
      <a
        href="/"
        style="background:none;border:none;color:var(--accent);font-size:0.76rem;cursor:pointer;font-family:inherit;padding:0;margin-bottom:28px;display:inline-block;text-decoration:none"
      >
        ← back
      </a>
      <h1
        style="font-size:1.05rem;font-weight:600;margin-bottom:24px;margin-top:20px"
      >
        help
      </h1>
      <div
        style="font-size:0.82rem;color:var(--muted);line-height:1.9;max-width:540px"
      >
        <p style="margin-bottom:14px">
          got a question? something broken? something you disagree with and want
          to talk about?
        </p>
        <p style="margin-bottom:14px">
          leave an anonymous comment on any post — it's the best way to reach
          me. i read all of them.
        </p>
        <p>
          if it's something bigger, you can probably find me on the internet
          somewhere. i'm not hard to locate if you actually look.
        </p>
      </div>
    </div>
  </main>
</Layout>
