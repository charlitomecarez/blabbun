---
import IssueForm from "@/components/help/IssueForm.svelte";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="help" description="Report an issue on Blab Bun.">
  <main
    class="mx-auto min-h-[60vh] w-full max-w-[680px] flex-1 px-4 py-6 sm:px-8 sm:py-8"
  >
    <div class="animate-[fadeIn_0.2s_ease]">
      <a
        href="/"
        class="mb-7 inline-block text-[0.76rem] text-[var(--accent)] no-underline"
      >
        ← back
      </a>

      <h1 class="mt-5 mb-1.5 text-[1.05rem] font-semibold">report an issue</h1>

      <p
        class="mb-8 max-w-[480px] text-[0.8rem] leading-[1.85] text-[var(--muted)]"
      >
        spotted something broken, confusing, or just off? fill this out and i'll
        get to it. attach a screenshot if it helps.
      </p>

      <IssueForm client:load />
    </div>
  </main>
</Layout>
