---
import IssueForm from "@/components/help/IssueForm.svelte";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="help" description="Report an issue on Blab Bun." noindex>
  <main
    class="mx-auto min-h-[60vh] w-full max-w-[680px] flex-1 px-4 py-6 sm:px-8 sm:py-10"
  >
    <div style="animation:fadeIn 0.2s ease">
      <!-- back -->
      <a
        href="/?utm_source=help&utm_medium=internal&utm_campaign=back_nav"
        style="color:var(--accent);font-family:'Caveat',cursive;font-size:1.1rem;
               text-decoration:none;padding:0;display:inline-block;margin-bottom:24px"
      >
        ← back to the blabs
      </a>

      <!-- title row -->
      <div
        style="display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin-bottom:8px"
      >
        <h1
          style="font-family:'Fraunces',serif;font-size:2.4rem;font-weight:600;letter-spacing:-0.02em"
        >
          help
        </h1>
        <span
          style="font-family:'Caveat',cursive;font-size:1.2rem;color:var(--accent);
                     transform:rotate(-3deg);display:inline-block"
        >
          something broken?
        </span>
      </div>

      <!-- scribble underline -->
      <svg
        width="140"
        height="14"
        viewBox="0 0 140 14"
        style="margin-bottom:28px;display:block"
      >
        <path
          d="M2 8 Q 24 2, 48 8 T 96 8 T 138 7"
          stroke="var(--accent)"
          stroke-width="2"
          fill="none"
          stroke-linecap="round"></path>
      </svg>

      <p
        style="font-size:0.88rem;color:var(--muted);line-height:1.85;max-width:480px;margin-bottom:32px"
      >
        spotted something broken, confusing, or just off? fill this out and i'll
        get to it. attach a screenshot if it helps.
      </p>

      <IssueForm client:load />
    </div>
  </main>

  <style>
    @media (max-width: 640px) {
      h1 {
        font-size: 1.75rem !important;
      }
    }
  </style>
</Layout>
