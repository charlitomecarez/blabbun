---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="help" description="Help for Blab Bun.">
  <main class="mx-auto min-h-[60vh] w-full max-w-[680px] flex-1 px-8">
    <div class="animate-[fadeIn_0.2s_ease]">
      <a
        href="/"
        class="mb-7 inline-block text-[0.76rem] text-[var(--accent)] no-underline"
      >
        ← back
      </a>

      <h1 class="mt-5 mb-6 text-[1.05rem] font-semibold">help</h1>

      <div
        class="max-w-[540px] text-[0.82rem] leading-[1.9] text-[var(--muted)]"
      >
        <p class="mb-3.5">
          got a question? something broken? something you disagree with and want
          to talk about?
        </p>

        <p class="mb-3.5">
          leave an anonymous comment on any post — it's the best way to reach
          me. i read all of them.
        </p>

        <p>
          if it's something bigger, you can probably find me on the internet
          somewhere. i'm not hard to locate if you actually look.
        </p>
      </div>
    </div>
  </main>
</Layout>
