# Project URL
SUPABASE_URL=https://<project-ref>.supabase.co
# Service Role Key (for server-side operations)
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Anon Key (for client-side, included in the .env)
SUPABASE_ANON_KEY=<anon-key>
# Resend API key — used to send welcome emails on subscription
RESEND_API_KEY=re_<your-api-key>
# Secret for signing unsubscribe tokens (generate: openssl rand -hex 32)
UNSUBSCRIBE_SECRET=<random-hex-secret>
# Secret Vercel sends with cron requests (generate: openssl rand -hex 32)
CRON_SECRET=<random-hex-secret>
