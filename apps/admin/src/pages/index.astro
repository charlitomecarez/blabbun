---
import { createSupabaseClient } from "@blabbun/db";
import { env } from "cloudflare:workers";

import { getAppEnv } from "@/lib/env";
import Layout from "../layouts/Layout.astro";

const runtimeEnv = env as unknown as Record<string, string | undefined>;
const appEnv = getAppEnv(runtimeEnv);
const supabase = createSupabaseClient(
  runtimeEnv.SUPABASE_URL ?? import.meta.env.SUPABASE_URL,
  runtimeEnv.SUPABASE_SERVICE_ROLE_KEY ??
    import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);

const [comments, subscribers, claps] = await Promise.all([
  supabase
    .from("comments")
    .select("id", { count: "exact", head: true })
    .eq("env", appEnv),
  supabase
    .from("subscribers")
    .select("id", { count: "exact", head: true })
    .eq("env", appEnv),
  supabase.from("post_claps").select("count").eq("env", appEnv),
]);

const totalClaps = ((claps.data ?? []) as { count: number }[]).reduce(
  (s, r) => s + (r.count ?? 0),
  0
);

const stats = [
  { label: "comments", value: comments.count ?? 0, href: "/comments" },
  { label: "subscribers", value: subscribers.count ?? 0, href: "/subscribers" },
  { label: "total claps", value: totalClaps, href: "/claps" },
];
---

<Layout title="dashboard">
  <!-- Stat cards -->
  <div
    style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:16px;margin-bottom:40px"
  >
    {
      stats.map((s) => (
        <a
          href={s.href}
          style="
          display:block;padding:20px;
          border:1px solid var(--border);border-radius:4px;
          background:var(--bg2);text-decoration:none;
          transition:border-color 0.15s;
        "
          onmouseenter="this.style.borderColor='var(--accent)'"
          onmouseleave="this.style.borderColor='var(--border)'"
        >
          <div style="font-size:1.4rem;font-weight:600;color:var(--text);margin-bottom:4px">
            {s.value.toLocaleString()}
          </div>
          <div style="font-size:0.68rem;color:var(--muted);letter-spacing:0.04em;text-transform:uppercase">
            {s.label}
          </div>
        </a>
      ))
    }
  </div>

  <!-- Quick links -->
  <div
    style="font-size:0.72rem;color:var(--muted);letter-spacing:0.06em;text-transform:uppercase;margin-bottom:12px"
  >
    manage
  </div>
  <div
    style="display:flex;flex-direction:column;gap:1px;border:1px solid var(--border);border-radius:4px;overflow:hidden;margin-bottom:40px"
  >
    {
      [
        { label: "view & delete comments", href: "/comments" },
        { label: "view & delete subscribers", href: "/subscribers" },
        { label: "view & reset post claps", href: "/claps" },
      ].map((l) => (
        <a
          href={l.href}
          style="
          display:flex;align-items:center;justify-content:space-between;
          padding:12px 16px;text-decoration:none;background:var(--bg);
          font-size:0.8rem;color:var(--text);border-bottom:1px solid var(--divider);
          transition:background 0.1s;
        "
          onmouseenter="this.style.background='var(--bg2)'"
          onmouseleave="this.style.background='var(--bg)'"
        >
          {l.label}
          <span style="color:var(--muted)">→</span>
        </a>
      ))
    }
  </div>

  <!-- Danger zone -->
  <div
    style="font-size:0.72rem;color:var(--muted);letter-spacing:0.06em;text-transform:uppercase;margin-bottom:12px"
  >
    danger zone
  </div>
  <div
    style="border:1px solid #e05c5c;border-radius:4px;padding:20px 24px;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap"
  >
    <div>
      <div
        style="font-size:0.82rem;font-weight:500;color:var(--text);margin-bottom:4px"
      >
        purge all test data
      </div>
      <div style="font-size:0.72rem;color:var(--muted);line-height:1.6">
        deletes every subscriber, comment, clap vote, and post clap.
        irreversible.
      </div>
    </div>
    <button
      id="purge-btn"
      style="
        background:none;border:1px solid #e05c5c;border-radius:3px;
        padding:8px 18px;font-size:0.76rem;font-family:inherit;
        color:#e05c5c;cursor:pointer;white-space:nowrap;
        transition:background 0.15s,color 0.15s;flex-shrink:0;
      "
      onmouseenter="this.style.background='#e05c5c';this.style.color='#fff'"
      onmouseleave="this.style.background='none';this.style.color='#e05c5c'"
    >
      purge test data
    </button>
  </div>

  <div id="purge-status" style="margin-top:10px;font-size:0.74rem;display:none">
  </div>
</Layout>

<script is:inline>
  document
    .getElementById("purge-btn")
    ?.addEventListener("click", async function () {
      const confirmed = window.confirm(
        "This will permanently delete ALL subscribers, comments, claps, and clap votes.\n\nContinue?"
      );
      if (!confirmed) return;

      // eslint-disable-next-line @typescript-eslint/no-this-alias
      const btn = this;
      const status = document.getElementById("purge-status");

      btn.disabled = true;
      btn.textContent = "purging…";
      if (status) {
        status.style.display = "none";
        status.textContent = "";
      }

      try {
        const res = await fetch("/api/purge-test-data", { method: "DELETE" });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error ?? "something went wrong");

        if (status) {
          status.textContent =
            "✓ all test data purged. reload to see updated counts.";
          status.style.color = "var(--accent3)";
          status.style.display = "block";
        }
        btn.textContent = "done";
      } catch (err) {
        if (status) {
          status.textContent =
            "✗ " + (err instanceof Error ? err.message : "failed");
          status.style.color = "#e05c5c";
          status.style.display = "block";
        }
        btn.disabled = false;
        btn.textContent = "purge test data";
      }
    });
</script>
