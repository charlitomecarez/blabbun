---
import { createSupabaseClient } from "@thelunan/db";
import Layout from "../layouts/Layout.astro";

const supabase = createSupabaseClient(
  import.meta.env.SUPABASE_URL,
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);

const { data: comments } = await supabase
  .from("comments")
  .select("*")
  .order("created_at", { ascending: false });
---

<Layout title="Comments">
  <div class="min-h-screen bg-gradient-to-br from-[#ebf3ed] to-white px-4 py-8">
    <div class="mx-auto max-w-4xl">
      <h1 class="font-manrope mb-8 text-4xl font-bold text-[#29302d]">
        Comments Management
      </h1>

      {
        comments && comments.length > 0 ? (
          <div class="space-y-4">
            {comments.map((comment: any) => (
              <div
                key={comment.id}
                data-comment-id={comment.id}
                class="rounded-lg border border-[#c5f7d0] bg-white p-6 shadow-sm"
              >
                <div class="mb-3 flex items-start justify-between">
                  <div>
                    <p class="font-manrope text-sm font-bold text-[#29302d]">
                      Post: {comment.post_slug}
                    </p>
                    <p class="font-manrope text-xs text-[rgba(41,48,45,0.6)]">
                      {new Date(comment.created_at).toLocaleString()}
                    </p>
                    {comment.parent_id && (
                      <p class="font-manrope mt-1 text-xs text-[#386547]">
                        ↳ Reply to {comment.parent_id}
                      </p>
                    )}
                  </div>
                  <button
                    onclick={`deleteComment('${comment.id}')`}
                    class="font-manrope rounded bg-red-500 px-4 py-2 text-sm font-bold text-white hover:bg-red-600"
                  >
                    Delete
                  </button>
                </div>
                <p class="font-manrope text-[15px] leading-relaxed text-[rgba(41,48,45,0.8)]">
                  {comment.body}
                </p>
              </div>
            ))}
          </div>
        ) : (
          <p class="font-manrope text-center text-[rgba(41,48,45,0.6)]">
            No comments yet.
          </p>
        )
      }
    </div>
  </div>

  <script>
    async function deleteComment(commentId: string) {
      if (!confirm("Are you sure you want to delete this comment?")) {
        return;
      }

      try {
        const res = await fetch(`/api/comments/${commentId}`, {
          method: "DELETE",
        });

        if (!res.ok) {
          const data = await res.json();
          alert(`Error: ${data.error}`);
          return;
        }

        const element = document.querySelector(
          `[data-comment-id="${commentId}"]`
        );
        if (element) {
          element.remove();
        } else {
          location.reload();
        }
      } catch (error) {
        alert("Failed to delete comment");
        console.error(error);
      }
    }

    (window as any).deleteComment = deleteComment;
  </script>
</Layout>
