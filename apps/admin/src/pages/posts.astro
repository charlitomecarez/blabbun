---
/* eslint-disable jsx-a11y/label-has-associated-control */

import { env } from "cloudflare:workers";

import Layout from "../layouts/Layout.astro";
import { listPostFiles } from "../lib/github";

interface PostMeta {
  slug: string;
  title: string;
  description: string;
  pubDate: string;
  draft: boolean;
  tags: string[];
}

function parseMeta(slug: string, raw: string): PostMeta {
  const fm = raw.match(/^---\n([\s\S]*?)\n---/);
  const block = fm?.[1] ?? "";
  const get = (key: string) => {
    const m = block.match(new RegExp(`^${key}:\\s*(.+)$`, "m"));
    return m ? m[1].trim().replace(/^["']|["']$/g, "") : "";
  };
  const tagsMatch = block.match(/^tags:\s*\[([^\]]*)\]/m);
  const tags = tagsMatch
    ? tagsMatch[1]
        .split(",")
        .map((t) => t.trim().replace(/^["']|["']$/g, ""))
        .filter(Boolean)
    : [];
  return {
    slug,
    title: get("title"),
    description: get("description"),
    pubDate: get("pubDate"),
    draft: get("draft") === "true",
    tags,
  };
}

const runtimeEnv = env as unknown as Record<string, string | undefined>;
const token = runtimeEnv.GITHUB_TOKEN ?? import.meta.env.GITHUB_TOKEN ?? "";

const files = await listPostFiles(token);
files.sort((a, b) => b.name.localeCompare(a.name));

const posts = await Promise.all(
  files.map(async (f) => {
    const slug = f.name.replace(/\.(mdx?|md)$/, "");
    const raw = await fetch(f.download_url).then((r) => r.text());
    return parseMeta(slug, raw);
  })
);

const today = new Date().toISOString().split("T")[0];
---

<Layout title="posts">
  <!-- Mobile tab toggle -->
  <div class="mobile-tabs">
    <button
      class="mobile-tab mobile-tab-active"
      id="tab-editor"
      onclick="switchTab('editor')">editor</button
    >
    <button class="mobile-tab" id="tab-preview" onclick="switchTab('preview')"
      >preview</button
    >
  </div>

  <div class="editor-layout">
    <!-- Editor form -->
    <div class="editor-form-panel" id="panel-editor">
      <div
        id="form-label"
        style="font-size:0.68rem;color:var(--muted);letter-spacing:0.06em;text-transform:uppercase;margin-bottom:14px"
      >
        new post
      </div>
      <div
        id="form-error"
        style="display:none;font-size:0.75rem;color:#c0392b;margin-bottom:10px"
      >
      </div>
      <form id="post-form" class="post-form-grid">
        <input type="hidden" id="f-overwrite" name="overwrite" value="false" />

        <div>
          <label
            for="f-title"
            style="font-size:0.68rem;color:var(--muted);letter-spacing:0.04em;display:block;margin-bottom:4px"
            >title *</label
          >
          <input
            id="f-title"
            name="title"
            type="text"
            required
            placeholder="post title"
            style="width:100%;padding:7px 10px;font-size:0.78rem;font-family:inherit;background:var(--bg);border:1px solid var(--border);border-radius:3px;color:var(--text);outline:none;box-sizing:border-box"
          />
        </div>

        <div>
          <label
            for="f-slug"
            style="font-size:0.68rem;color:var(--muted);letter-spacing:0.04em;display:block;margin-bottom:4px"
            >slug</label
          >
          <input
            id="f-slug"
            name="slug"
            type="text"
            placeholder="auto-generated"
            style="width:100%;padding:7px 10px;font-size:0.78rem;font-family:inherit;background:var(--bg);border:1px solid var(--border);border-radius:3px;color:var(--text);outline:none;box-sizing:border-box"
          />
        </div>

        <div style="grid-column:1/-1">
          <label
            for="f-description"
            style="font-size:0.68rem;color:var(--muted);letter-spacing:0.04em;display:block;margin-bottom:4px"
            >description *</label
          >
          <input
            id="f-description"
            name="description"
            type="text"
            required
            placeholder="one-line summary"
            style="width:100%;padding:7px 10px;font-size:0.78rem;font-family:inherit;background:var(--bg);border:1px solid var(--border);border-radius:3px;color:var(--text);outline:none;box-sizing:border-box"
          />
        </div>

        <div
          style="display:grid;grid-template-columns:1fr auto;gap:8px;align-items:end"
        >
          <div>
            <label
              for="f-pubDate"
              style="font-size:0.68rem;color:var(--muted);letter-spacing:0.04em;display:block;margin-bottom:4px"
              >date *</label
            >
            <input
              id="f-pubDate"
              name="pubDate"
              type="date"
              value={today}
              required
              style="width:100%;padding:7px 10px;font-size:0.78rem;font-family:inherit;background:var(--bg);border:1px solid var(--border);border-radius:3px;color:var(--text);outline:none;box-sizing:border-box"
            />
          </div>
          <label
            style="display:flex;align-items:center;gap:6px;font-size:0.75rem;color:var(--muted);cursor:pointer;padding-bottom:9px;white-space:nowrap"
          >
            <input
              id="f-draft"
              type="checkbox"
              style="accent-color:var(--accent)"
            />
            draft
          </label>
        </div>

        <div>
          <label
            for="f-tags"
            style="font-size:0.68rem;color:var(--muted);letter-spacing:0.04em;display:block;margin-bottom:4px"
            >tags</label
          >
          <input
            id="f-tags"
            name="tags"
            type="text"
            placeholder="RANTS, LIFE STUFF, EDITORIAL"
            style="width:100%;padding:7px 10px;font-size:0.78rem;font-family:inherit;background:var(--bg);border:1px solid var(--border);border-radius:3px;color:var(--text);outline:none;box-sizing:border-box"
          />
          <div style="display:flex;gap:4px;flex-wrap:wrap;margin-top:5px">
            {
              ["RANTS", "LIFE STUFF", "EDITORIAL", "TECH", "PERSONAL"].map(
                (tag) => (
                  <button
                    type="button"
                    onclick={`addTag('${tag}')`}
                    style="padding:2px 8px;font-size:0.62rem;font-family:inherit;background:none;border:1px solid var(--border);border-radius:2px;color:var(--muted);cursor:pointer;letter-spacing:0.04em"
                    onmouseenter="this.style.borderColor='var(--accent)';this.style.color='var(--accent)'"
                    onmouseleave="this.style.borderColor='var(--border)';this.style.color='var(--muted)'"
                  >
                    + {tag}
                  </button>
                )
              )
            }
          </div>
        </div>

        <div style="grid-column:1/-1">
          <label
            for="f-image"
            style="font-size:0.68rem;color:var(--muted);letter-spacing:0.04em;display:block;margin-bottom:4px"
            >image URL</label
          >
          <input
            id="f-image"
            name="image"
            type="url"
            placeholder="https://..."
            style="width:100%;padding:7px 10px;font-size:0.78rem;font-family:inherit;background:var(--bg);border:1px solid var(--border);border-radius:3px;color:var(--text);outline:none;box-sizing:border-box"
          />
        </div>

        <div>
          <label
            for="f-imageSource"
            style="font-size:0.68rem;color:var(--muted);letter-spacing:0.04em;display:block;margin-bottom:4px"
            >image source</label
          >
          <input
            id="f-imageSource"
            name="imageSource"
            type="text"
            placeholder="Unsplash"
            style="width:100%;padding:7px 10px;font-size:0.78rem;font-family:inherit;background:var(--bg);border:1px solid var(--border);border-radius:3px;color:var(--text);outline:none;box-sizing:border-box"
          />
        </div>

        <div>
          <label
            for="f-imageSourceUrl"
            style="font-size:0.68rem;color:var(--muted);letter-spacing:0.04em;display:block;margin-bottom:4px"
            >source URL</label
          >
          <input
            id="f-imageSourceUrl"
            name="imageSourceUrl"
            type="url"
            placeholder="https://..."
            style="width:100%;padding:7px 10px;font-size:0.78rem;font-family:inherit;background:var(--bg);border:1px solid var(--border);border-radius:3px;color:var(--text);outline:none;box-sizing:border-box"
          />
        </div>

        <div style="grid-column:1/-1">
          <div
            style="display:flex;align-items:center;justify-content:space-between;margin-bottom:4px"
          >
            <label
              for="f-content"
              style="font-size:0.68rem;color:var(--muted);letter-spacing:0.04em"
              >body (MDX)</label
            >
            <button
              type="button"
              onclick="insertImageSnippet()"
              style="padding:2px 8px;font-size:0.62rem;font-family:inherit;background:none;border:1px solid var(--border);border-radius:2px;color:var(--muted);cursor:pointer;letter-spacing:0.04em"
              onmouseenter="this.style.borderColor='var(--accent)';this.style.color='var(--accent)'"
              onmouseleave="this.style.borderColor='var(--border)';this.style.color='var(--muted)'"
              title="Insert a <figure> image snippet at cursor position"
              >+ image</button
            >
          </div>
          <textarea
            id="f-content"
            name="content"
            rows="14"
            placeholder="Write your post in Markdown / MDX..."
            style="width:100%;padding:8px 10px;font-size:0.75rem;font-family:'IBM Plex Mono',monospace;background:var(--bg);border:1px solid var(--border);border-radius:3px;color:var(--text);outline:none;resize:vertical;box-sizing:border-box;line-height:1.6"
          ></textarea>
          <div
            style="display:flex;gap:10px;margin-top:5px;font-size:0.65rem;color:var(--muted2);font-family:'IBM Plex Mono',monospace"
          >
            <span id="wc-words">0 words</span>
            <span style="color:var(--border)">·</span>
            <span id="wc-read">0 min read</span>
            <span style="color:var(--border)">·</span>
            <span style="color:var(--muted2)"
              >blank line = new paragraph — avoid <code
                style="font-family:inherit;background:var(--bg2);padding:1px 4px;border-radius:2px"
                >&lt;br/&gt;</code
              > between paragraphs</span
            >
          </div>
          <div
            style="margin-top:6px;padding:10px 12px;background:var(--bg);border:1px solid var(--border);border-radius:3px;font-size:0.68rem;color:var(--muted2);font-family:'IBM Plex Mono',monospace;line-height:1.8"
          >
            <span style="color:var(--muted);letter-spacing:0.04em"
              >image snippet</span
            ><br />
            &lt;figure&gt;<br />
            &nbsp;&nbsp;&lt;img src="<span style="color:var(--accent)"
              >image-url</span
            >" alt="<span style="color:var(--accent)">description</span>" /&gt;<br
            />
            &nbsp;&nbsp;&lt;figcaption&gt;photo by &lt;a href="<span
              style="color:var(--accent)">source-url</span
            >"&gt;<span style="color:var(--accent)">Source Name</span
            >&lt;/a&gt;&lt;/figcaption&gt;<br />
            &lt;/figure&gt;
          </div>
        </div>

        <div style="grid-column:1/-1;display:flex;gap:8px">
          <button
            type="submit"
            id="submit-btn"
            style="padding:7px 16px;font-size:0.75rem;font-family:inherit;background:var(--accent);color:#fff;border:none;border-radius:3px;cursor:pointer"
            >save post</button
          >
          <button
            type="button"
            onclick="resetForm()"
            style="padding:7px 14px;font-size:0.75rem;font-family:inherit;background:none;border:1px solid var(--border);border-radius:3px;color:var(--muted);cursor:pointer"
            >clear</button
          >
        </div>
      </form>
    </div><!-- end form -->

    <!-- Live preview panel — mirrors [slug].astro + PostHero layout -->
    <div id="post-preview" class="editor-preview-panel" data-panel="preview">
      <div
        id="preview-empty"
        style="padding:48px 24px;text-align:center;color:var(--muted);font-size:0.75rem"
      >
        start typing to preview
      </div>
      <div id="preview-content" style="display:none;padding:20px 24px">
        <!-- back link (decorative) -->
        <span
          style="font-family:'Caveat',cursive;font-size:1.1rem;color:var(--accent);display:inline-block;margin-bottom:20px"
          >← back to the blabs</span
        >

        <!-- Date + tags + read time row -->
        <div
          style="display:flex;gap:10px;align-items:center;margin-bottom:14px;flex-wrap:wrap"
        >
          <span
            id="preview-date"
            style="font-family:'Caveat',cursive;font-size:0.95rem;color:var(--muted)"
          ></span>
          <div id="preview-tags" style="display:flex;gap:6px;flex-wrap:wrap">
          </div>
          <span
            id="preview-readtime"
            style="font-size:0.68rem;color:var(--muted2)"></span>
        </div>

        <!-- Title (Fraunces serif — matches PostHero) -->
        <h1
          id="preview-title"
          style="font-family:'Fraunces',serif;font-size:2rem;font-weight:600;line-height:1.08;text-wrap:balance;max-width:100%;letter-spacing:-0.02em;color:var(--text);margin-bottom:18px"
        >
        </h1>

        <!-- Scribble underline SVG -->
        <svg
          width="220"
          height="14"
          viewBox="0 0 220 14"
          style="margin-bottom:24px;display:block"
          aria-hidden="true"
        >
          <path
            d="M2 8 Q 40 2, 80 8 T 160 8 T 218 7"
            stroke="var(--accent)"
            stroke-width="2"
            fill="none"
            stroke-linecap="round"></path>
        </svg>

        <!-- Optional hero image (below header, matching [slug].astro) -->
        <div id="preview-image-wrap" style="display:none;margin-bottom:24px">
          <img
            id="preview-image"
            src=""
            alt=""
            style="width:100%;max-height:280px;object-fit:cover;border-radius:6px;display:block"
          />
        </div>

        <!-- Body (prose-styled to match [slug].astro) -->
        <div id="preview-body" class="preview-prose"></div>
      </div>
    </div>
  </div><!-- end flex wrapper -->

  <!-- Post list -->
  <div style="font-size:0.72rem;color:var(--muted);margin-bottom:12px">
    {posts.length} posts
  </div>
  <div
    id="post-list"
    style="border:1px solid var(--border);border-radius:4px;overflow:hidden"
  >
    {
      posts.length === 0 ? (
        <p style="font-size:0.8rem;color:var(--muted);padding:24px">
          no posts yet.
        </p>
      ) : (
        posts.map((p) => (
          <div
            data-slug={p.slug}
            style="padding:12px 16px;border-bottom:1px solid var(--divider);background:var(--bg);display:flex;align-items:center;justify-content:space-between;gap:12px"
          >
            <div style="min-width:0;flex:1">
              <div style="display:flex;align-items:center;gap:8px;margin-bottom:2px;flex-wrap:wrap">
                {p.draft && (
                  <span style="font-size:0.6rem;letter-spacing:0.06em;text-transform:uppercase;color:#c4832a;background:rgba(196,131,42,0.1);padding:1px 6px;border-radius:2px">
                    draft
                  </span>
                )}
                <span style="font-size:0.8rem;font-weight:500;color:var(--text)">
                  {p.title}
                </span>
              </div>
              <div style="font-size:0.68rem;color:var(--muted2)">
                {p.pubDate} · /{p.slug}
              </div>
            </div>
            <div style="display:flex;gap:6px;flex-shrink:0">
              <button
                onclick={`editPost('${p.slug}')`}
                style="background:none;border:1px solid var(--border);border-radius:3px;padding:3px 10px;font-size:0.68rem;color:var(--muted);cursor:pointer;font-family:inherit"
                onmouseenter="this.style.borderColor='var(--accent)';this.style.color='var(--accent)'"
                onmouseleave="this.style.borderColor='var(--border)';this.style.color='var(--muted)'"
              >
                edit
              </button>
              <button
                onclick={`deletePost('${p.slug}')`}
                style="background:none;border:1px solid var(--border);border-radius:3px;padding:3px 10px;font-size:0.68rem;color:var(--muted);cursor:pointer;font-family:inherit"
                onmouseenter="this.style.borderColor='#e05c5c';this.style.color='#e05c5c'"
                onmouseleave="this.style.borderColor='var(--border)';this.style.color='var(--muted)'"
              >
                delete
              </button>
            </div>
          </div>
        ))
      )
    }
  </div>
</Layout>

<script>
  import DOMPurify from "dompurify";
  import { marked } from "marked";

  const $ = (id: string) =>
    document.getElementById(id) as
      | HTMLInputElement
      | HTMLTextAreaElement
      | null;

  function slugify(s: string) {
    return s
      .toLowerCase()
      .replace(/[^a-z0-9\s-]/g, "")
      .trim()
      .replace(/\s+/g, "-")
      .replace(/-+/g, "-");
  }

  // Auto-generate slug from title (only when slug is untouched)
  let slugManuallyEdited = false;
  $("f-slug")?.addEventListener("input", () => {
    slugManuallyEdited = true;
  });
  $("f-title")?.addEventListener("input", (e) => {
    if (!slugManuallyEdited) {
      const slugEl = $("f-slug") as HTMLInputElement;
      if (slugEl) slugEl.value = slugify((e.target as HTMLInputElement).value);
    }
  });

  function addTag(tag: string) {
    const el = $("f-tags") as HTMLInputElement;
    if (!el) return;
    const current = el.value
      .split(",")
      .map((t) => t.trim())
      .filter(Boolean);
    if (!current.includes(tag)) {
      el.value = [...current, tag].join(", ");
    }
  }

  function resetForm() {
    const form = document.getElementById("post-form") as HTMLFormElement;
    form?.reset();
    ($("f-overwrite") as HTMLInputElement).value = "false";
    slugManuallyEdited = false;
    document.getElementById("form-label")!.textContent = "new post";
    document.getElementById("form-error")!.style.display = "none";
    ($("submit-btn") as HTMLButtonElement).textContent = "save post";
    updatePreview();
  }

  async function editPost(slug: string) {
    const res = await fetch(`/api/posts/${slug}`);
    if (!res.ok) {
      alert("failed to load post");
      return;
    }
    const p = (await res.json()) as {
      title: string;
      slug: string;
      description: string;
      pubDate: string;
      draft: boolean;
      tags: string[];
      image?: string;
      imageSource?: string;
      imageSourceUrl?: string;
      body: string;
    };

    ($("f-title") as HTMLInputElement).value = p.title;
    ($("f-slug") as HTMLInputElement).value = p.slug;
    ($("f-description") as HTMLInputElement).value = p.description;
    ($("f-pubDate") as HTMLInputElement).value = p.pubDate;
    ($("f-draft") as HTMLInputElement).checked = p.draft;
    ($("f-tags") as HTMLInputElement).value = p.tags.join(", ");
    ($("f-image") as HTMLInputElement).value = p.image ?? "";
    ($("f-imageSource") as HTMLInputElement).value = p.imageSource ?? "";
    ($("f-imageSourceUrl") as HTMLInputElement).value = p.imageSourceUrl ?? "";
    ($("f-content") as HTMLTextAreaElement).value = p.body;
    ($("f-overwrite") as HTMLInputElement).value = "true";
    slugManuallyEdited = true;

    document.getElementById("form-label")!.textContent = `editing — ${slug}`;
    ($("submit-btn") as HTMLButtonElement).textContent = "update post";
    document
      .getElementById("post-form")
      ?.scrollIntoView({ behavior: "smooth" });
    updatePreview();
  }

  async function deletePost(slug: string) {
    if (!confirm(`delete "${slug}"? this removes the MDX file permanently.`))
      return;
    const res = await fetch(`/api/posts/${slug}`, { method: "DELETE" });
    if (res.ok) {
      document.querySelector(`[data-slug="${slug}"]`)?.remove();
    } else {
      alert("failed to delete");
    }
  }

  document
    .getElementById("post-form")
    ?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = document.getElementById("submit-btn") as HTMLButtonElement;
      const errEl = document.getElementById("form-error")!;

      const slug =
        ($("f-slug") as HTMLInputElement).value.trim() ||
        slugify(($("f-title") as HTMLInputElement).value);

      const payload = {
        title: ($("f-title") as HTMLInputElement).value,
        slug,
        description: ($("f-description") as HTMLInputElement).value,
        pubDate: ($("f-pubDate") as HTMLInputElement).value,
        draft: String(($("f-draft") as HTMLInputElement).checked),
        tags: ($("f-tags") as HTMLInputElement).value,
        image: ($("f-image") as HTMLInputElement).value,
        imageSource: ($("f-imageSource") as HTMLInputElement).value,
        imageSourceUrl: ($("f-imageSourceUrl") as HTMLInputElement).value,
        content: ($("f-content") as HTMLTextAreaElement).value,
        overwrite: ($("f-overwrite") as HTMLInputElement).value,
      };

      btn.disabled = true;
      btn.textContent = "saving…";
      errEl.style.display = "none";

      const res = await fetch("/api/posts", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const json = (await res.json()) as { error?: string };

      if (res.ok) {
        location.reload();
      } else {
        errEl.textContent = json.error ?? "failed to save";
        errEl.style.display = "block";
        btn.disabled = false;
        btn.textContent = "save post";
      }
    });

  function updateWordCount(content: string) {
    const words = content.trim() ? content.trim().split(/\s+/).length : 0;
    const mins = Math.max(1, Math.round(words / 200));
    const wordsEl = document.getElementById("wc-words");
    const readEl = document.getElementById("wc-read");
    if (wordsEl)
      wordsEl.textContent = `${words.toLocaleString()} word${words !== 1 ? "s" : ""}`;
    if (readEl)
      readEl.textContent = words === 0 ? "0 min read" : `${mins} min read`;
  }

  const TAG_CLASS_MAP: Record<string, string> = {
    RANTS: "tag-rants",
    TAKES: "tag-takes",
    "HALF-BAKED IDEAS": "tag-halfbaked",
    "LIFE STUFF": "tag-lifestuff",
    CULTURE: "tag-culture",
    EDITORIAL: "tag-editorial",
    TECHNICAL: "tag-technical",
  };
  function tagClass(tag: string): string {
    return TAG_CLASS_MAP[tag.toUpperCase()] ?? "tag-default";
  }

  function updatePreview() {
    const title = ($("f-title") as HTMLInputElement)?.value ?? "";
    const pubDate = ($("f-pubDate") as HTMLInputElement)?.value ?? "";
    const image = ($("f-image") as HTMLInputElement)?.value ?? "";
    const content = ($("f-content") as HTMLTextAreaElement)?.value ?? "";
    const tagsRaw = ($("f-tags") as HTMLInputElement)?.value ?? "";

    updateWordCount(content);

    const isEmpty = !title && !content;

    const emptyEl = document.getElementById("preview-empty");
    const contentEl = document.getElementById("preview-content");
    if (emptyEl) emptyEl.style.display = isEmpty ? "block" : "none";
    if (contentEl) contentEl.style.display = isEmpty ? "none" : "block";
    if (isEmpty) return;

    // Image (after title block)
    const imageWrap = document.getElementById("preview-image-wrap");
    const imageEl = document.getElementById(
      "preview-image"
    ) as HTMLImageElement | null;
    if (imageWrap && imageEl) {
      imageWrap.style.display = image ? "block" : "none";
      imageEl.src = image;
    }

    // Date — short month format matching PostHero
    const dateEl = document.getElementById("preview-date");
    if (dateEl) {
      dateEl.textContent = pubDate
        ? new Date(pubDate + "T00:00:00").toLocaleDateString("en-US", {
            month: "short",
            day: "numeric",
            year: "numeric",
          })
        : "—";
    }

    // Tags — colored badges matching PostHero
    const tagList = tagsRaw
      .split(",")
      .map((t) => t.trim().toUpperCase())
      .filter(Boolean);
    const tagsEl = document.getElementById("preview-tags");
    if (tagsEl) {
      tagsEl.innerHTML = tagList
        .map(
          (t) =>
            `<span class="${tagClass(t)}" style="font-size:0.68rem;padding:2px 8px;border-radius:2px;letter-spacing:0.04em;font-weight:500;white-space:nowrap">${t}</span>`
        )
        .join("");
    }

    // Read time
    const words = content.trim() ? content.trim().split(/\s+/).length : 0;
    const mins = Math.max(1, Math.round(words / 200));
    const readtimeEl = document.getElementById("preview-readtime");
    if (readtimeEl)
      readtimeEl.textContent = words > 0 ? `${mins} min read` : "";

    // Title (Fraunces serif)
    const titleEl = document.getElementById("preview-title");
    if (titleEl) titleEl.textContent = title || "untitled";

    // Body — post-process to make <br/> gaps match the client exactly.
    // In MDX + Tailwind Typography, a standalone <br/> between paragraphs
    // creates a full extra line-height of space on top of the paragraph
    // margin-bottom. marked renders it as a near-invisible browser line-break,
    // causing writers to add more <br/> tags than needed.
    const bodyEl = document.getElementById("preview-body");
    if (bodyEl) {
      let html = marked.parse(content, { async: false }) as string;
      // Case 1: marked wraps standalone <br/> in its own <p>: </p><p><br/></p><p>
      html = html.replace(
        /<\/p>\s*<p>\s*<br\s*\/?>\s*<\/p>\s*<p/gi,
        '</p><div class="preview-br-spacer"></div><p'
      );
      // Case 2: bare <br/> between paragraphs: </p><br/><p>
      html = html.replace(
        /<\/p>\s*<br\s*\/?>\s*<p/gi,
        '</p><div class="preview-br-spacer"></div><p'
      );
      bodyEl.innerHTML = DOMPurify.sanitize(html, {
        ADD_TAGS: ["div"],
        ADD_ATTR: ["class"],
      });
    }
  }

  ["f-title", "f-pubDate", "f-image", "f-tags", "f-content"].forEach((id) =>
    document.getElementById(id)?.addEventListener("input", updatePreview)
  );
  updatePreview();

  function insertImageSnippet() {
    const textarea = $("f-content") as HTMLTextAreaElement;
    if (!textarea) return;
    const snippet = `\n<figure>\n  <img src="image-url" alt="description" />\n  <figcaption>photo by <a href="source-url">Source Name</a></figcaption>\n</figure>\n`;
    const start = textarea.selectionStart;
    const end = textarea.selectionEnd;
    textarea.value =
      textarea.value.slice(0, start) + snippet + textarea.value.slice(end);
    textarea.selectionStart = textarea.selectionEnd = start + snippet.length;
    textarea.focus();
    updatePreview();
  }

  function switchTab(tab: "editor" | "preview") {
    const editorPanel = document.getElementById("panel-editor");
    const previewPanel = document.getElementById("post-preview");
    const tabEditor = document.getElementById("tab-editor");
    const tabPreview = document.getElementById("tab-preview");
    if (!editorPanel || !previewPanel || !tabEditor || !tabPreview) return;

    const isMobile = window.innerWidth <= 768;
    if (!isMobile) return;

    if (tab === "editor") {
      editorPanel.style.display = "block";
      previewPanel.style.display = "none";
      tabEditor.classList.add("mobile-tab-active");
      tabPreview.classList.remove("mobile-tab-active");
    } else {
      editorPanel.style.display = "none";
      previewPanel.style.display = "block";
      tabEditor.classList.remove("mobile-tab-active");
      tabPreview.classList.add("mobile-tab-active");
    }
  }

  // Reset panels to correct state on resize
  window.addEventListener("resize", () => {
    const editorPanel = document.getElementById("panel-editor");
    const previewPanel = document.getElementById("post-preview");
    if (!editorPanel || !previewPanel) return;
    if (window.innerWidth > 768) {
      editorPanel.style.display = "";
      previewPanel.style.display = "";
    }
  });

  Object.assign(window, {
    editPost,
    deletePost,
    addTag,
    resetForm,
    insertImageSnippet,
    switchTab,
  });
</script>

