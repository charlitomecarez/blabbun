---
import "@blabbun/ui/styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const { pathname } = Astro.url;

const nav = [
  { label: "dashboard", href: "/" },
  { label: "posts", href: "/posts" },
  { label: "comments", href: "/comments" },
  { label: "subscribers", href: "/subscribers" },
  { label: "post claps", href: "/claps" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — blabbun admin</title>
    <link rel="icon" type="image/png" href="/blabbun.png" />
    <script is:inline>
      document.documentElement.classList.add(
        localStorage.getItem("bb-theme") === "dark" ? "dark-init" : ""
      );
    </script>
    <style is:inline>
      body {
        min-height: 100vh;
        display: flex;
      }
    </style>
  </head>
  <body class="light" style="min-height:100vh;display:flex;flex-direction:row">
    <script is:inline>
      document.body.className = localStorage.getItem("bb-theme") || "light";
    </script>

    <!-- Sidebar -->
    <aside
      style="
        width:200px;flex-shrink:0;
        border-right:1px solid var(--divider);
        background:var(--bg2);
        padding:24px 0;
        display:flex;flex-direction:column;
        position:sticky;top:0;height:100vh;overflow-y:auto;
      "
    >
      <!-- Logo -->
      <a
        href="/"
        style="
          display:flex;align-items:center;gap:8px;
          padding:0 20px;margin-bottom:28px;
          text-decoration:none;
        "
      >
        <img
          src="/blabbun.png"
          alt="blab bun"
          width="22"
          height="22"
          style="width:22px;height:22px;object-fit:contain"
        />
        <span style="font-size:0.82rem;font-weight:600;color:var(--text)">
          admin<span style="color:var(--accent)">.</span>
        </span>
      </a>

      <!-- Nav -->
      <nav style="display:flex;flex-direction:column;gap:2px;padding:0 10px">
        {
          nav.map((link) => {
            const active = pathname === link.href;
            return (
              <a
                href={link.href}
                style={`
                font-size:0.72rem;padding:7px 10px;border-radius:3px;
                text-decoration:none;letter-spacing:0.02em;
                color:${active ? "var(--accent)" : "var(--muted)"};
                background:${active ? "var(--accent-soft)" : "transparent"};
                font-weight:${active ? "500" : "400"};
                transition:background 0.1s,color 0.1s;
              `}
              >
                {link.label}
              </a>
            );
          })
        }
      </nav>

      <!-- Theme toggle at bottom -->
      <div style="margin-top:auto;padding:0 10px">
        <button
          id="theme-btn"
          style="
            width:100%;background:none;border:1px solid var(--border);border-radius:3px;
            padding:6px 10px;font-size:0.68rem;color:var(--muted);cursor:pointer;
            font-family:inherit;letter-spacing:0.04em;text-align:left;
          "
        >
          ◑ toggle theme
        </button>
      </div>
    </aside>

    <!-- Main -->
    <main style="flex:1;padding:32px 40px;max-width:900px;overflow-y:auto">
      <div
        style="margin-bottom:24px;padding-bottom:20px;border-bottom:1px solid var(--divider)"
      >
        <h1 style="font-size:1rem;font-weight:600;color:var(--text)">
          {title}
        </h1>
      </div>
      <slot />
    </main>

    <script is:inline>
      document.getElementById("theme-btn").addEventListener("click", () => {
        const isDark = document.body.classList.contains("dark");
        const next = isDark ? "light" : "dark";
        document.body.className = next;
        localStorage.setItem("bb-theme", next);
      });
    </script>
  </body>
</html>
