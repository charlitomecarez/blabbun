{
  "name": "blabbun",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:client": "pnpm --filter @blabbun/client dev",
    "dev:admin": "pnpm --filter @blabbun/admin dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "prepare": "husky",
    "notify:local": "bash scripts/notify-subscribers.sh",
    "notify:prod": "BASE_URL=https://blabbun.com bash scripts/notify-subscribers.sh",
    "notify:test": "node --env-file=apps/client/.env.local apps/client/scripts/notify-test.mjs",
    "notify:send": "node --env-file=apps/client/.env.local apps/client/scripts/notify-test.mjs --send",
    "cd:root": "$SHELL",
    "cd:client": "cd apps/client && $SHELL",
    "cd:admin": "cd apps/admin && $SHELL",
    "cd:ui": "cd packages/ui && $SHELL",
    "cd:types": "cd packages/types && $SHELL",
    "cd:utils": "cd packages/utils && $SHELL"
  },
  "lint-staged": {
    "*.{js,ts,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.astro": [
      "prettier --write"
    ],
    "*.svelte": [
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.19.0+sha512.c9fc7236e92adf5c8af42fd5bf1612df99c2ceb62f27047032f4720b33f8eacdde311865e91c411f2774f618d82f320808ecb51718bfa82c060c4ba7c76a32b8",
  "devDependencies": {
    "@typescript-eslint/parser": "^8.59.0",
    "eslint": "^10.2.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript-eslint": "^8.58.2",
    "wrangler": "^4.85.0"
  },
  "dependencies": {
    "@types/lodash": "^4.17.24",
    "lodash-es": "^4.18.1"
  }
}
