{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "plugins": [{ "name": "typescript-svelte-plugin" }]
  },
  "include": ["components/**/*.ts", "components/**/*.svelte", "styles/**/*"]
}
